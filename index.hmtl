<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Instagram Pro</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:Arial,sans-serif;background:#f2f2f2;color:#111}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{max-width:520px;margin:auto;min-height:100vh;background:#fff;padding-bottom:72px}
header{position:sticky;top:0;z-index:20;height:64px;background:#fff;border-bottom:1px solid #e8e8e8;display:flex;align-items:center;justify-content:space-between;padding:0 15px}
.logo{font-size:25px;font-weight:800}
.top-icons{display:flex;gap:8px;align-items:center}
.iconBtn{border:0;background:none;font-size:23px;padding:7px}
.page{display:none}.page.active{display:block}
.searchBox{padding:12px;background:#fff}
.searchBox input,.section>input{width:100%;padding:13px 16px;border:1px solid #ddd;border-radius:14px;background:#f4f4f4;outline:none}
.stories{display:flex;gap:16px;padding:14px 12px;border-bottom:1px solid #eee;overflow-x:auto}
.story{min-width:64px;text-align:center;font-size:11px}.story button{border:0;background:none;padding:0}
.avatar{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff;font-weight:800;margin:0 auto 7px;border:3px solid #fff;outline:2px solid #e1306c}
.post{border-bottom:1px solid #ddd;background:#fff}
.postHead{display:flex;align-items:center;gap:10px;padding:12px}
.mini{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);display:grid;place-items:center;color:#fff;font-weight:800}
.postMedia{width:100%;max-height:620px;background:#eee;display:block;object-fit:cover}
.placeholderMedia{height:330px;display:grid;place-items:center;font-size:72px;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)}
.actions{display:flex;gap:18px;padding:10px 12px;font-size:25px}.actionBtn{border:0;background:none;padding:0}.actionBtn.liked{color:#e31b23}
.caption{padding:0 12px 14px;line-height:1.45}.muted{color:#777;font-size:13px}
.commentBox{display:flex;gap:7px;padding:0 12px 12px}.commentBox input{flex:1;border:1px solid #ddd;border-radius:18px;padding:9px 12px}
.commentBox button,.primary{border:0;background:#111;color:#fff;border-radius:18px;padding:9px 14px}.comments{padding:0 12px 10px}.comment{font-size:13px;margin:5px 0}

.notificationsBtn{position:relative}.notifBadge{position:absolute;top:1px;right:0;min-width:17px;height:17px;padding:0 4px;border-radius:9px;background:#ed1c24;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;font-weight:800}.notifList{display:flex;flex-direction:column;gap:8px}.notifItem{display:flex;gap:12px;align-items:flex-start;padding:14px;border:1px solid #e5e5e5;border-radius:16px;background:#fff}.notifItem.unread{background:#f5f8ff;border-color:#d9e5ff}.notifIcon{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#f0f0f0;font-size:20px;flex:0 0 42px}.notifText{flex:1}.notifText b{font-weight:800}.notifTime{font-size:11px;color:#777;margin-top:4px}.notifActions{display:flex;gap:8px;margin:12px 0}.notifFilter{border:1px solid #ddd;background:#fff;border-radius:18px;padding:8px 12px}.dark .notifItem{background:#181818;border-color:#333}.dark .notifItem.unread{background:#202736;border-color:#33456b}.dark .notifFilter{background:#222;color:#eee;border-color:#444}
.bottomNav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);height:66px;background:#fff;border-top:1px solid #ddd;display:flex;justify-content:space-around;align-items:center;z-index:30;padding-bottom:env(safe-area-inset-bottom)}
.bottomNav button{border:0;background:none;font-size:22px;padding:4px 9px}.bottomNav small{display:block;font-size:9px}
.section{padding:18px 16px}.card{border:1px solid #ddd;border-radius:16px;padding:15px;margin-bottom:12px}
.profileStats{display:flex;gap:0;margin:18px 0;border-top:1px solid #eee;border-bottom:1px solid #eee}.profileStat{flex:1;border:0;background:none;padding:14px 4px;text-align:center}.profileStat b{display:block;font-size:18px}.profileStat span{display:block;font-size:12px;color:#777;margin-top:3px}.followList{display:flex;flex-direction:column;gap:8px}.followCard{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #ddd;border-radius:14px;background:#fff}.followCard .mini{flex:0 0 42px;width:42px;height:42px}.followCardInfo{flex:1}.followCard button{border:0;border-radius:10px;padding:8px 12px;background:#111;color:#fff}.followCard button.following{background:#eee;color:#111}.dark .profileStats{border-color:#333}.dark .followCard{background:#222;border-color:#444}.dark .followCard button.following{background:#333;color:#eee}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}.gridItem{aspect-ratio:1;background:#eee;display:grid;place-items:center;overflow:hidden}.gridItem img,.gridItem video{width:100%;height:100%;object-fit:cover}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:50;align-items:flex-end}.modal.open{display:flex}
.sheet{background:#fff;width:min(520px,100%);margin:auto;padding:18px;border-radius:22px 22px 0 0;max-height:92vh;overflow:auto}
.sheet h2{margin-top:0}.sheet input,.sheet textarea,.sheet select{width:100%;padding:12px;border:1px solid #ccc;border-radius:12px;margin:7px 0}
.preview{width:100%;max-height:300px;object-fit:contain;border-radius:14px;background:#eee;margin-top:8px}
.row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid #eee}
.row span small{display:block;margin-top:4px}.settingBtn{border:0;background:none;width:100%;text-align:left;padding:0}
.toggle{width:50px;height:28px;border:0;border-radius:20px;background:#bbb;position:relative}.toggle:after{content:'';position:absolute;width:22px;height:22px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.toggle.on{background:#111}.toggle.on:after{left:25px}
.toast{position:fixed;left:50%;bottom:82px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 16px;border-radius:20px;z-index:100;display:none}
.empty{text-align:center;padding:35px;color:#777}
.reel{position:relative;background:#000;color:#fff;margin-bottom:8px;min-height:650px;overflow:hidden}
.reel video,.reel img{width:100%;height:650px;object-fit:cover;display:block}.reelShade{position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(0,0,0,.8));pointer-events:none}
.reelInfo{position:absolute;left:14px;right:78px;bottom:18px;z-index:2}.reelInfo h3{margin:0 0 7px}.reelInfo p{margin:0;line-height:1.35}
.reelActions{position:absolute;right:10px;bottom:25px;z-index:3;display:flex;flex-direction:column;gap:18px;align-items:center}.reelActions button{border:0;background:rgba(0,0,0,.35);color:#fff;border-radius:50%;width:48px;height:48px;font-size:22px}.reelActions small{font-size:10px;margin-top:-13px}.reelActions button.saved,.reelActions button.reposted{background:rgba(255,255,255,.2)}
.chatList{padding:0 16px}.chatItem{display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid #eee}.chatItem button{border:0;background:none;text-align:left;flex:1}
.chatWindow{display:flex;flex-direction:column;height:calc(100vh - 136px);min-height:480px}.chatHeader{padding:12px 16px;border-bottom:1px solid #eee;display:flex;align-items:center;gap:10px}.chatMessages{flex:1;overflow:auto;padding:14px;background:#f5f5f5}.bubbleRow{display:flex;margin:7px 0}.bubbleRow.mine{justify-content:flex-end}.bubble{max-width:78%;padding:9px 12px;border-radius:17px;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.08);position:relative}.mine .bubble{background:#111;color:#fff}.bubbleMeta{font-size:9px;opacity:.65;margin-top:4px}.bubbleMenu{font-size:10px;margin-left:5px;border:0;background:none;color:inherit}
.chatComposer{display:flex;gap:6px;padding:10px;border-top:1px solid #ddd;background:#fff;align-items:center}.chatComposer input{flex:1;padding:11px;border:1px solid #ccc;border-radius:20px;min-width:0}.chatComposer button{border:0;border-radius:20px;background:#111;color:#fff;padding:0 14px;height:40px}.chatComposer .attachBtn{width:40px;padding:0;background:#eee;color:#111;font-size:18px}.messageMedia{max-width:230px;max-height:260px;border-radius:12px;display:block;margin-bottom:5px}.voiceMsg{display:flex;align-items:center;gap:8px}.reactionRow{margin-top:4px}.reactionBtn{border:0;background:transparent;padding:2px 5px;font-size:14px}.reactionCount{font-size:11px;opacity:.75}
.filter-warm{filter:saturate(1.2) sepia(.15)}.filter-cool{filter:saturate(1.05) hue-rotate(12deg)}.filter-vintage{filter:sepia(.35) contrast(.95)}.filter-bw{filter:grayscale(1)}
.dark body{background:#111;color:#eee}.dark .app,.dark header,.dark .bottomNav,.dark .post,.dark .searchBox,.dark .card,.dark .sheet,.dark .chatHeader,.dark .chatComposer{background:#181818;color:#eee}
.privateMsg{border:0;border-radius:14px;padding:10px 12px;background:rgba(0,0,0,.08);font-weight:700;cursor:pointer;color:inherit}.mine .privateMsg{background:rgba(255,255,255,.14);color:#fff}.privateExpired{opacity:.65;font-style:italic}.chatComposer select{border:1px solid #ddd;border-radius:10px;padding:8px;background:#fff;font-size:12px}.dark .chatComposer select{background:#222;color:#eee;border-color:#444}
.dark .searchBox input,.dark input,.dark textarea,.dark select{background:#222;color:#eee;border-color:#444}.dark .row,.dark .post,.dark .chatItem{border-color:#333}.dark .bottomNav{border-color:#333}.dark .muted{color:#aaa}.dark .commentBox input,.dark .chatComposer input{background:#222;color:#fff;border-color:#444}.dark .chatMessages{background:#111}.dark .bubble{background:#222;color:#eee}

.storyModal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:60;display:none;align-items:center;justify-content:center;padding:14px}.storyModal.show{display:flex}.storySheet{width:min(520px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:22px;padding:16px}.storyPreview{height:430px;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;margin:10px 0;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff}.storyPreview img,.storyPreview video{width:100%;height:100%;object-fit:cover}.storyTextOverlay{position:absolute;left:20px;right:20px;bottom:25px;font-size:24px;font-weight:700;text-align:center;text-shadow:0 2px 8px #000}.storyMention{position:absolute;top:20px;left:20px;background:rgba(0,0,0,.45);padding:7px 10px;border-radius:12px}.storyTools{display:flex;gap:7px;overflow-x:auto;padding:4px 0}.storyTools button{white-space:nowrap;border:1px solid #ddd;background:#fff;border-radius:18px;padding:8px 11px}.storyReply{display:flex;gap:7px;margin-top:10px}.storyReply input{flex:1}.storyView{position:fixed;inset:0;background:#000;z-index:70;display:none;color:#fff;padding:18px}.storyView.show{display:flex;flex-direction:column}.storyViewContent{flex:1;display:flex;align-items:center;justify-content:center;text-align:center}.storyViewContent img,.storyViewContent video{max-width:100%;max-height:75vh}.storyReplyList{max-height:100px;overflow:auto;font-size:13px}.storyMusic{background:#f5f5f5;padding:8px;border-radius:12px;margin-top:7px}

.searchResult{display:block;width:100%;text-align:left;cursor:pointer;border:1px solid #ddd;background:#fff}.searchResult:hover{transform:translateY(-1px)}
.messageRequests{margin:0 12px 12px}.requestBar{display:flex;justify-content:space-between;align-items:center;background:#f6f6f6;border-radius:14px;padding:12px;margin-bottom:8px}.requestBadge{background:#e11;color:#fff;border-radius:999px;padding:2px 7px;font-size:11px}.requestCard{display:flex;gap:10px;align-items:center;border:1px solid #ddd;border-radius:14px;padding:11px;margin:7px 0;background:#fff}.requestActions{margin-left:auto;display:flex;gap:5px}.requestActions button{border:0;border-radius:10px;padding:7px 9px}.acceptReq{background:#111;color:#fff}.declineReq{background:#eee}.dark .requestBar,.dark .requestCard{background:#222;border-color:#444}
/* Instagram Pro realistic UI refresh */
:root{--ig-text:#111;--ig-muted:#737373;--ig-border:#dbdbdb;--ig-bg:#fafafa;--ig-blue:#0095f6}
html,body{background:var(--ig-bg);color:var(--ig-text)}
body{letter-spacing:-.01em}
.app{max-width:520px;background:#fff;box-shadow:0 0 30px rgba(0,0,0,.05);padding-bottom:82px}
header{height:62px;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--ig-border);padding:0 14px}
.logo{font-family:Arial,sans-serif;font-size:24px;letter-spacing:-1px}
.logo:after{content:' Pro';font-size:12px;font-weight:700;letter-spacing:0;color:#8e8e8e;margin-left:3px}
.top-icons{gap:2px}.iconBtn{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-size:21px;transition:background .15s,transform .15s}.iconBtn:active{transform:scale(.92);background:#f2f2f2}
.searchBox{padding:10px 12px 8px}.searchBox input{height:38px;border:0;border-radius:10px;background:#efefef;font-size:14px;padding:0 14px}
.stories{gap:14px;padding:12px 12px 13px;background:#fff;border-bottom:1px solid #efefef}.story{min-width:66px;font-size:11px;color:#262626}.story button{color:inherit}.avatar{width:62px;height:62px;border:2px solid #fff;outline:2px solid #d62976;box-shadow:0 0 0 3px #f5f5f5;font-size:14px}
.post{border-bottom:8px solid #f5f5f5}.postHead{padding:10px 12px}.postHead .mini{width:34px;height:34px}.postMedia{max-height:none;aspect-ratio:1/1;background:#f1f1f1}.placeholderMedia{height:auto;aspect-ratio:1/1;font-size:64px}.actions{gap:16px;padding:9px 12px 6px}.actionBtn{font-size:25px;transition:transform .12s}.actionBtn:active{transform:scale(.84)}.caption{font-size:14px;padding:0 12px 10px}.commentBox{padding:0 12px 12px}.commentBox input{border:0;background:#f6f6f6}.commentBox button{background:transparent;color:#0095f6;font-weight:700}
.bottomNav{height:60px;background:rgba(255,255,255,.97);backdrop-filter:blur(14px);border-top:1px solid #ddd;box-shadow:0 -4px 18px rgba(0,0,0,.04)}.bottomNav button{font-size:21px;min-width:48px;color:#111;opacity:.9}.bottomNav button small{font-size:9px;color:#737373;margin-top:2px}.bottomNav button:active{transform:scale(.92)}
.section{padding:16px 14px}.card,.settingGroup{border:1px solid var(--ig-border);border-radius:14px;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.02)}
.profileStats{margin:18px 0;border-color:#eee}.profileStat b{font-size:17px}.profileStat span{font-size:11px}
.primary{background:#0095f6;border-radius:9px;padding:9px 16px;font-weight:700}.primary:active{transform:scale(.97)}
.grid img,.grid .placeholderMedia{border-radius:2px}
.reel{min-height:calc(100vh - 124px);margin-bottom:2px;border-radius:0;background:#111}.reelInfo{bottom:22px}.reelActions{bottom:24px}.reelActions button{background:rgba(20,20,20,.5);backdrop-filter:blur(8px)}
.chatMessages{background:#f7f7f7}.bubble{border-radius:18px}.mine .bubble{background:#0095f6}.chatComposer button{background:#0095f6}
.row{padding:15px 0}.setting{border-radius:10px!important}.toast{bottom:76px;box-shadow:0 8px 25px rgba(0,0,0,.22)}
.notifItem{border-color:#eee}.notifItem.unread{background:#f1f7ff;border-color:#d8eaff}
.badgeVerified{display:inline-grid;place-items:center;width:15px;height:15px;border-radius:50%;background:#0095f6;color:#fff;font-size:10px;font-weight:900;margin-left:3px;vertical-align:middle}
.liveDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#22c55e;margin-right:4px}
@media(max-width:380px){.top-icons .iconBtn{width:34px}.top-icons{gap:0}.stories{gap:10px}.story{min-width:62px}}
.dark .app{box-shadow:none}.dark header,.dark .bottomNav{background:rgba(24,24,24,.96)}.dark .searchBox input{background:#262626}.dark .post{border-bottom-color:#101010}.dark .bottomNav button{color:#fff}.dark .bottomNav button small{color:#aaa}.dark .primary{background:#0095f6}

/* Instagram Pro camera UI - phone-first, camera-app style */
.creatorOverlay{position:fixed;inset:0;width:100%;height:100dvh;background:#000;color:#fff;z-index:200;display:none;flex-direction:column;overflow:hidden}
.creatorOverlay.show{display:flex}
.creatorStage{position:relative;flex:1 1 auto;min-height:0;background:#000;overflow:hidden;border-radius:0 0 22px 22px}
.creatorStage video,.creatorStage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.creatorTop{position:absolute;top:0;left:0;right:0;height:76px;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;padding:12px 18px;z-index:8;background:linear-gradient(rgba(0,0,0,.38),transparent)}
.creatorTopLeft{text-align:left}.creatorTopCenter{text-align:center}.creatorTopRight{text-align:right}
.creatorIcon{border:0;background:transparent;color:#fff;font-size:38px;line-height:1;width:48px;height:48px;text-shadow:0 2px 8px #000;padding:0}
.creatorGear{font-size:34px}.creatorClose{font-size:46px;font-weight:300}.creatorMute{font-size:30px}
.creatorSide{position:absolute;left:28px;top:50%;transform:translateY(-38%);display:flex;flex-direction:column;gap:26px;z-index:8}
.creatorTool{border:0;background:transparent;color:#fff;text-align:left;font-size:16px;font-weight:600;display:flex;align-items:center;gap:13px;text-shadow:0 2px 8px #000;padding:0}
.creatorTool .toolIcon{font-size:31px;width:42px;text-align:center}.creatorArrow{font-size:34px;margin-left:5px}
.creatorCaption{position:absolute;left:18px;right:18px;bottom:20px;z-index:8;display:none}.creatorCaption input{width:100%;box-sizing:border-box;background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:14px;padding:11px 13px;outline:none}
.creatorPublish{display:none;position:absolute;right:18px;bottom:22px;z-index:10;border:0;background:#0095f6;color:#fff;font-weight:700;padding:12px 18px;border-radius:22px}
.creatorPublish.show{display:block}
.creatorToast{position:absolute;left:50%;bottom:28px;transform:translateX(-50%);background:rgba(0,0,0,.72);padding:9px 14px;border-radius:18px;font-size:13px;display:none;z-index:20;white-space:nowrap}
.creatorBottom{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(transparent,rgba(0,0,0,.92) 18%,#000 42%);padding:26px 18px max(16px,env(safe-area-inset-bottom));z-index:50;box-sizing:border-box;width:100%;display:block;visibility:visible;overflow:visible}
.creatorControls{display:flex;align-items:center;justify-content:space-between;max-width:430px;margin:auto;height:88px;position:relative;z-index:55}
.creatorGallery{width:58px;height:58px;border:2px solid #fff;border-radius:10px;overflow:hidden;background:#222;display:flex;align-items:center;justify-content:center;flex:none}
.creatorGallery img{width:100%;height:100%;object-fit:cover}.creatorGallery span{font-size:28px}
.creatorShutter{width:82px;height:82px;border:4px solid #fff;border-radius:50%;background:#f5f5f5;box-shadow:0 0 0 2px #111 inset;flex:none}
.creatorShutter.recording{background:#e53935;border-radius:24px;transform:scale(.72)}
.creatorSwitch{border:0;background:transparent;color:#fff;font-size:34px;width:58px;height:58px;flex:none}
.creatorModes{display:flex!important;justify-content:center;align-items:center;gap:22px;margin:4px auto 0;color:#fff;font-size:15px;letter-spacing:1.5px;font-weight:700;min-height:42px;height:42px;position:relative;z-index:60;visibility:visible!important;opacity:1!important;white-space:nowrap}
.creatorMode{border:0;background:transparent;color:#fff!important;font-size:15px;letter-spacing:1.5px;font-weight:700;padding:7px 4px;min-width:48px;opacity:1!important;display:block!important;visibility:visible!important;text-shadow:0 1px 5px #000}.creatorMode.active{color:#fff!important;text-shadow:0 0 8px rgba(255,255,255,.65);font-weight:900}
.creatorHint{text-align:center;font-size:10px;color:#aaa;min-height:15px;height:15px;margin-top:0;visibility:visible}
@media(max-width:430px){.creatorSide{left:22px;gap:25px}.creatorTool{font-size:15px}.creatorModes{gap:12px}.creatorShutter{width:80px;height:80px}.creatorControls{height:86px}.creatorBottom{padding-left:10px;padding-right:10px;padding-top:22px}}
@media(max-height:650px){.creatorBottom{padding-top:8px}.creatorControls{height:72px}.creatorShutter{width:66px;height:66px}.creatorModes{height:36px;min-height:36px;margin-top:0}.creatorMode{font-size:13px}.creatorHint{display:none}}


/* V5: prominent Create button */
.creatorCreateButton{position:absolute;left:20px;top:44%;transform:translateY(-50%);z-index:90;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.58);color:#fff;border-radius:18px;padding:12px 18px;font-size:17px;font-weight:800;display:flex;align-items:center;gap:9px;box-shadow:0 3px 14px rgba(0,0,0,.35);backdrop-filter:blur(6px)}
.creatorCreateButton:active{transform:translateY(-50%) scale(.96)}
.creatorCreateButton .plus{font-size:24px;line-height:1}
@media(max-width:430px){.creatorCreateButton{left:16px;font-size:16px;padding:11px 15px}}
.creatorCreateButton{display:none!important}.creatorModes{position:relative!important;z-index:200!important}.creatorMode{cursor:pointer!important;}

.profileCreatorHub{border:1px solid #e6e6e6;border-radius:16px;padding:14px;margin:0 0 18px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.profileCreatorGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.profileCreateCard{border:1px solid #ddd;border-radius:14px;background:#fafafa;padding:12px 5px 10px;min-height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#111}
.profileCreateCard span{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#111;color:#fff;font-size:18px;font-weight:800}
.profileCreateCard b{font-size:13px}.profileCreateCard small{font-size:9px;color:#777;text-align:center}
.profileCreateCard:active{transform:scale(.96)}
.profileCreateCard.live span{background:#e53935}.profileCreateCard.reel span{background:#7c3aed}.profileCreateCard.story span{background:#e1306c}.profileCreateCard.post span{background:#0095f6}
.dark .profileCreatorHub{background:#181818;border-color:#333}.dark .profileCreateCard{background:#222;border-color:#444;color:#fff}.dark .profileCreateCard small{color:#aaa}
@media(max-width:380px){.profileCreatorGrid{gap:5px}.profileCreateCard{padding-left:2px;padding-right:2px}.profileCreateCard b{font-size:12px}}
</style>

<!-- Supabase backend foundation -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
window.INSTAGRAM_PRO_BACKEND = {
  url: 'https://jwxenahmdznfdcyyyfwk.supabase.co',
  publishableKey: 'sb_publishable_MXu5WeDwf_dZx7QEfSG7nw_K0Zu1TYA'
};
window.supabaseClient = null;
function initBackend(){
  const c=window.INSTAGRAM_PRO_BACKEND;
  if(!window.supabase || !c || c.url.includes('YOUR_') || c.publishableKey.includes('YOUR_')) return false;
  window.supabaseClient=window.supabase.createClient(c.url,c.publishableKey,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
  return true;
}
async function signUpOnline(email,password,username,displayName=''){
  if(!initBackend()) throw new Error('Backend is not configured yet.');
  return await window.supabaseClient.auth.signUp({email,password,options:{data:{username,display_name:displayName}}});
}
async function signInOnline(email,password){
  if(!initBackend()) throw new Error('Backend is not configured yet.');
  return await window.supabaseClient.auth.signInWithPassword({email,password});
}
async function signOutOnline(){
  if(window.supabaseClient) return await window.supabaseClient.auth.signOut();
}
async function getOnlineSession(){
  if(!initBackend()) return null;
  const {data}=await window.supabaseClient.auth.getSession();
  return data.session;
}
async function loadOnlineProfile(){
  const session=await getOnlineSession(); if(!session)return null;
  const {data,error}=await window.supabaseClient.from('profiles').select('*').eq('id',session.user.id).single();
  if(error) throw error;
  return data;
}
initBackend();
</script>
<!-- Supabase profile backend -->
<script>
window.INSTAGRAM_PRO_PROFILE_TABLE='profiles';
async function upsertCloudProfile(){
  try{
    const session=await getOnlineSession();
    if(!session||!window.supabaseClient)return false;
    const prof=db?.profile||{};
    const row={
      id:session.user.id,
      username:String(prof.username||session.user.user_metadata?.username||'samuel').replace(/^@/,''),
      display_name:String(prof.name||session.user.user_metadata?.display_name||'Samuel'),
      bio:String(prof.bio||''),
      avatar_url:prof.avatar_url||null,
      followers:Array.isArray(prof.followers)?prof.followers:[],
      following:Array.isArray(prof.following)?prof.following:[],
      updated_at:new Date().toISOString()
    };
    const {error}=await window.supabaseClient.from(window.INSTAGRAM_PRO_PROFILE_TABLE).upsert(row,{onConflict:'id'});
    if(error)throw error;
    return true;
  }catch(e){console.warn('Supabase profile save failed',e);return false}
}
async function loadCloudProfile(){
  try{
    const session=await getOnlineSession();
    if(!session||!window.supabaseClient)return false;
    const {data,error}=await window.supabaseClient.from(window.INSTAGRAM_PRO_PROFILE_TABLE).select('*').eq('id',session.user.id).maybeSingle();
    if(error)throw error;
    if(data){
      db.profile=db.profile||{};
      if(data.username)db.profile.username=data.username;
      if(data.display_name)db.profile.name=data.display_name;
      if(typeof data.bio==='string')db.profile.bio=data.bio;
      if(data.avatar_url)db.profile.avatar_url=data.avatar_url;
      if(Array.isArray(data.followers))db.profile.followers=data.followers;
      if(Array.isArray(data.following))db.profile.following=data.following;
      saveLocalOnly();
      return true;
    }
    await upsertCloudProfile();
    return false;
  }catch(e){console.warn('Supabase profile load failed',e);return false}
}
</script>

<!-- Real Supabase app-state backend -->
<script>
window.INSTAGRAM_PRO_CLOUD={table:'app_state',syncDelay:500};
window.instagramCloud={
 userId:null,ready:false,timer:null,loading:false,saving:false,pending:false,
 async session(){
  try{if(!window.supabaseClient)initBackend();const {data,error}=await window.supabaseClient.auth.getSession();if(error)throw error;this.userId=data?.session?.user?.id||null;return data?.session||null}catch(e){console.warn('Supabase session error',e);return null}
 },
 async load(){
  const session=await this.session();if(!session||!window.supabaseClient)return false;this.loading=true;
  try{
   const {data,error}=await window.supabaseClient.from(window.INSTAGRAM_PRO_CLOUD.table).select('data,updated_at').eq('user_id',session.user.id).maybeSingle();
   if(error)throw error;this.userId=session.user.id;
   if(data?.data&&typeof data.data==='object'){
    const merged=Object.assign(structuredClone(defaults),data.data);
    merged.profile=Object.assign(structuredClone(defaults.profile),data.data.profile||{});
    db=merged;
   }else{await this.save(true)}
   await loadCloudProfile();
   saveLocalOnly();
   if(typeof renderFeed==='function')renderFeed();if(typeof renderReels==='function')renderReels();if(typeof renderProfile==='function')renderProfile();if(typeof renderNotifications==='function')renderNotifications();if(typeof renderSettings==='function')renderSettings();if(typeof renderChats==='function')renderChats();if(typeof updateNotificationBadge==='function')updateNotificationBadge();
   showToast('Synced with Supabase ☁️');
   this.ready=true;return true;
  }catch(e){console.warn('Supabase cloud load failed',e);showToast('Cloud sync failed — check app_state table and RLS');return false}finally{this.loading=false}
 },
 queue(){
  if(!this.userId||this.loading){this.pending=true;return;}
  this.pending=true;clearTimeout(this.timer);
  this.timer=setTimeout(()=>this.save(),window.INSTAGRAM_PRO_CLOUD.syncDelay);
 },
 async save(force=false){
  if(this.saving){this.pending=true;return false;}
  if(!window.supabaseClient)return false;
  const session=await this.session();if(!session)return false;
  this.saving=true;this.pending=false;
  try{
   const payload={user_id:session.user.id,data:db,updated_at:new Date().toISOString()};
   const {error}=await window.supabaseClient.from(window.INSTAGRAM_PRO_CLOUD.table).upsert(payload,{onConflict:'user_id'});
   if(error)throw error;
   await upsertCloudProfile();
   this.userId=session.user.id;this.ready=true;return true;
  }catch(e){console.warn('Supabase cloud save failed',e);this.pending=true;if(force)showToast('Cloud save failed — check app_state RLS');return false}
  finally{this.saving=false;if(this.pending&&!this.loading){clearTimeout(this.timer);this.timer=setTimeout(()=>this.save(),window.INSTAGRAM_PRO_CLOUD.syncDelay)}}
 }
};
async function syncCurrentUserFromSupabase(){if(!window.supabaseClient)initBackend();try{const {data:{session}}=await window.supabaseClient.auth.getSession();if(session){await window.instagramCloud.load();return session}}catch(e){console.warn(e)}return null}
</script>

</head>
<body>
<div class="app">
<header>
  <div class="logo">Instagram Pro</div>
  <div class="top-icons">
    <button class="iconBtn" onclick="showPage('search')" aria-label="Search">⌕</button>
    <button class="iconBtn" onclick="openSupabaseLogin()" aria-label="Login">🔐</button>
    <button class="iconBtn notificationsBtn" onclick="showPage('notifications')" aria-label="Notifications">🔔<span id="notifBadge" class="notifBadge" style="display:none">0</span></button>
    <button class="iconBtn" onclick="showPage('owner')" aria-label="Owner Dashboard">👑</button>
  </div>
</header>

<main>
<section id="home" class="page active">
  <div class="searchBox"><input id="feedSearch" placeholder="🔍 Search Instagram Pro" oninput="renderFeed()"></div>
  <div class="stories" id="stories"></div>
  <div id="feed"></div>
</section>

<section id="notifications" class="page">
  <div class="section"><div style="display:flex;justify-content:space-between;align-items:center"><h2 style="margin:0">Notifications</h2><button class="primary" onclick="markAllNotificationsRead()">Mark all read</button></div>
    <div class="notifActions"><button class="notifFilter" onclick="setNotifFilter('all')">All</button><button class="notifFilter" onclick="setNotifFilter('social')">Social</button><button class="notifFilter" onclick="setNotifFilter('messages')">Messages</button></div>
    <div id="notificationsList" class="notifList"></div>
  </div>
</section>

<section id="search" class="page">
  <div class="section"><h2>Search</h2><input id="globalSearch" placeholder="Search users, captions..." oninput="renderSearch()"><div id="searchResults"></div></div>
</section>

<section id="reels" class="page">
  <div class="section" style="padding-bottom:8px"><div style="display:flex;justify-content:space-between;align-items:center"><h2 style="margin:0">Reels</h2><button class="primary" onclick="openCreate('reel')">＋ Reel</button></div></div>
  <div id="reelsFeed"></div>
</section>

<section id="messages" class="page">
  <div id="chatListView">
    <div class="section"><h2>Messages</h2><input id="messageSearch" placeholder="🔍 Search messages..." oninput="renderChats()"></div>
    <div class="messageRequests"><button class="requestBar" style="width:100%;border:0" onclick="toggleMessageRequests()"><span>📩 Message Requests</span><span id="requestBadge" class="requestBadge">0</span></button><div id="messageRequestsPanel" style="display:none"></div></div>
    <div class="chatList" id="chatList"></div>
  </div>
  <div id="chatWindowView" style="display:none">
    <div class="chatWindow">
      <div class="chatHeader"><button class="iconBtn" onclick="closeChat()">‹</button><div class="mini" id="chatAvatar">A</div><div><b id="chatName">Alex</b><div class="muted" id="chatStatus">Active now</div></div></div>
      <div class="chatMessages" id="chatMessages"></div>
      <input id="chatMediaInput" type="file" accept="image/*,video/*" hidden onchange="sendChatMedia(this)">
      <div class="chatComposer">
        <button class="attachBtn" onclick="document.getElementById('chatMediaInput').click()" title="Photo or video">＋</button>
        <button class="attachBtn" onclick="toggleVoiceRecording()" id="voiceBtn" title="Voice message">🎤</button>
        <select id="messageViewMode" title="Message privacy">
          <option value="normal">Keep</option>
          <option value="once">View once</option>
          <option value="twice">View twice</option>
        </select>
        <input id="messageInput" placeholder="Message..." onkeydown="if(event.key==='Enter')sendMessage()">
        <button onclick="sendMessage()">Send</button>
      </div>
    </div>
  </div>
</section>

<section id="create" class="page">
  <div class="section">
    <h2>Create</h2>
    <div class="card"><h3>New Post</h3><textarea id="quickCaption" placeholder="Write a caption..."></textarea><input id="quickMedia" type="file" accept="image/*,video/*"><button class="primary" onclick="createFromQuick()">Publish Post</button></div>
    <div class="card"><h3>Story</h3><button class="primary" onclick="openCreate('story')">＋ Add Story</button></div>
    <div class="card"><h3>Reel</h3><p class="muted">Choose a video and publish it to your Reels feed.</p><button class="primary" onclick="openCreate('reel')">＋ Create Reel</button></div>
  </div>
</section>

<section id="profile" class="page">
  <div class="section">
    <div style="display:flex;gap:16px;align-items:center"><div class="avatar" style="margin:0;width:78px;height:78px">S</div><div><h2 id="profileName" style="margin:0">Samuel</h2><p id="profileUsername" class="muted">@samuel</p></div></div>
    <p id="profileBio">Welcome to my Instagram Pro profile 🚀</p>
    <div style="display:flex;gap:8px;align-items:center;margin:10px 0 14px">
      <button class="primary" onclick="editProfile()">Edit profile</button>
      <button class="iconBtn" style="border:1px solid #ddd;border-radius:12px;padding:8px 12px" onclick="showPage('settings')" aria-label="Settings">⚙️</button>
    </div>

    <div class="profileCreatorHub">
      <h3 style="margin:0 0 10px">Create</h3>
      <div class="profileCreatorGrid">
        <button class="profileCreateCard story" onclick="openCreate('story')"><span>＋</span><b>Story</b><small>Photo or video</small></button>
        <button class="profileCreateCard post" onclick="openCreate('post')"><span>＋</span><b>Post</b><small>Photo or video</small></button>
        <button class="profileCreateCard reel" onclick="openCreate('reel')"><span>▶</span><b>Reel</b><small>Short video</small></button>
        <button class="profileCreateCard live" onclick="openCreate('live')"><span>●</span><b>Live</b><small>Go live</small></button>
      </div>
      <p class="muted" style="margin:9px 2px 0">Choose Story, Post, Reel or Live. The camera screen will open directly.</p>
    </div>

    <div class="profileStats"><button class="profileStat" onclick="showFollowList('followers')"><b id="profileFollowers">0</b><span>Followers</span></button><button class="profileStat" onclick="showFollowList('following')"><b id="profileFollowing">0</b><span>Following</span></button><button class="profileStat"><b id="profilePosts">0</b><span>Posts</span></button><button class="profileStat"><b id="profileLikes">0</b><span>Likes</span></button></div>
    <div id="followListPanel" class="card" style="display:none"></div><h3>My posts</h3><div class="grid" id="profileGrid"></div>
  </div>
</section>

<section id="owner" class="page">
  <div class="section"><div style="display:flex;justify-content:space-between;align-items:center"><h2>👑 Owner Dashboard</h2><span class="muted">Admin control center</span></div>
    <div id="ownerStats" class="grid2"></div>
    <div class="settingGroup"><h3>📈 Platform overview</h3><div id="ownerOverview"></div></div>
    <div class="settingGroup"><h3>👥 Users</h3><div id="ownerUsers"></div></div>
    <div class="settingGroup"><h3>🛠️ Controls</h3><div class="row"><button class="primary" onclick="ownerAnnouncement()">📢 Announcement</button><button onclick="ownerToggleMaintenance()">🔧 Maintenance</button><button onclick="ownerResetDemo()">♻️ Reset demo data</button></div><div id="ownerMaintenance" class="muted"></div></div>
  </div>
</section>

<section id="settings" class="page">
  <div class="section"><h2>Settings</h2><input placeholder="🔎 Search settings..." oninput="filterSettings(this.value)">
    <div id="settingsList">
      <div class="card settingGroup"><h4>YOUR ACCOUNT</h4>
        <button class="settingBtn" onclick="showDashboard()"><div class="row"><span>👤 <b>Account</b><small class="muted">Profile and personal information</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="showDashboard()"><div class="row"><span>📊 <b>Dashboard & Earnings</b><small class="muted">Views, followers and KSh earnings</small></span><span>›</span></div></button>
      </div>
      <div class="card settingGroup"><h4>PRIVACY & SECURITY</h4>
        <div class="row"><span>🔒 <b>Privacy</b><small class="muted">Who can see and interact with you</small></span><span>›</span></div>
        <div class="row"><span>🛡️ <b>Security</b><small class="muted">Password and login protection</small></span><span>›</span></div>
        <div class="row"><span>🚫 <b>Blocked & Restricted</b><small class="muted">Manage blocked accounts</small></span><span>›</span></div>
      </div>
      <div class="card settingGroup"><h4>INTERACTIONS</h4>
        <button class="settingBtn" onclick="showPage('messages')"><div class="row"><span>💬 <b>Messages & Replies</b><small class="muted">Open your conversations</small></span><span>›</span></div></button>
        <div class="row"><span>@ <b>Mentions & Tags</b><small class="muted">Control mentions and tags</small></span><span>›</span></div>
        <div class="row"><span>🟢 <b>Activity Status</b><small class="muted">Show when you are active</small></span><button id="statusToggle" class="toggle on" onclick="toggleStatus()"></button></div>
        <div class="row"><span>🌙 <b>Theme</b><small class="muted">Light or dark mode</small></span><select onchange="setTheme(this.value)" id="themeSelect"><option value="light">Light</option><option value="dark">Dark</option></select></div>
      </div>
      <div class="card settingGroup"><h4>ACCOUNT SECURITY</h4>
        <button class="settingBtn" onclick="changePasswordDemo()"><div class="row"><span>🔑 <b>Change Password</b><small class="muted">Update your account password</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="showLoginActivity()"><div class="row"><span>📱 <b>Login Activity</b><small class="muted">See devices signed in</small></span><span>›</span></div></button>
        <div class="row"><span>🛡️ <b>Two-Factor Authentication</b><small class="muted">Extra login protection</small></span><button id="twoFactorToggle" class="toggle" onclick="toggleTwoFactor()"></button></div>
        <button class="settingBtn" onclick="logoutAllDemo()"><div class="row"><span>🚪 <b>Log out of all devices</b><small class="muted">Sign out other sessions</small></span><span>›</span></div></button>
      </div>
      <div class="card settingGroup"><h4>PRIVACY</h4>
        <div class="row"><span>🔒 <b>Private Account</b><small class="muted">Only approved followers can see your content</small></span><button id="privateToggle" class="toggle" onclick="togglePrivateAccount()"></button></div>
        <button class="settingBtn" onclick="privacyChoices()"><div class="row"><span>💬 <b>Who can message you</b><small class="muted">Everyone, followers, or nobody</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="commentChoices()"><div class="row"><span>💭 <b>Comments & replies</b><small class="muted">Choose who can interact</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="tagMentionChoices()"><div class="row"><span>@️⃣ <b>Mentions & Tags</b><small class="muted">Control who can mention or tag you</small></span><span>›</span></div></button>
        <div class="row"><span>👁️ <b>Read Receipts</b><small class="muted">Show when messages are read</small></span><button id="readReceiptToggle" class="toggle on" onclick="toggleReadReceipts()"></button></div>
      </div>
      <div class="card settingGroup"><h4>NOTIFICATIONS</h4>
        <div class="row"><span>🔔 <b>Push Notifications</b><small class="muted">Allow app notifications</small></span><button id="pushToggle" class="toggle on" onclick="toggleSetting('push')"></button></div>
        <div class="row"><span>❤️ <b>Likes & Comments</b></span><button id="likeNotifToggle" class="toggle on" onclick="toggleSetting('likes')"></button></div>
        <div class="row"><span>👥 <b>Followers & Mentions</b></span><button id="socialNotifToggle" class="toggle on" onclick="toggleSetting('social')"></button></div>
        <div class="row"><span>💌 <b>Messages & Requests</b></span><button id="messageNotifToggle" class="toggle on" onclick="toggleSetting('messages')"></button></div>
      </div>
      <div class="card settingGroup"><h4>CONTENT & APP</h4>
        <button class="settingBtn" onclick="showContentPrefs()"><div class="row"><span>🚫 <b>Hidden Words</b><small class="muted">Filter unwanted comments and messages</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="showMutedAccounts()"><div class="row"><span>🔇 <b>Muted Accounts</b><small class="muted">Manage accounts you muted</small></span><span>›</span></div></button>
        <div class="row"><span>📶 <b>Data Saver</b><small class="muted">Reduce media data usage</small></span><button id="dataSaverToggle" class="toggle" onclick="toggleSetting('dataSaver')"></button></div>
        <button class="settingBtn" onclick="downloadInfoDemo()"><div class="row"><span>📥 <b>Download Your Information</b><small class="muted">Prepare a copy of your app data</small></span><span>›</span></div></button>
      </div>
      <div class="card settingGroup"><h4>ACCOUNT MANAGEMENT</h4>
        <button class="settingBtn" onclick="deactivateDemo()"><div class="row"><span>⏸️ <b>Deactivate Account</b><small class="muted">Temporarily hide your account</small></span><span>›</span></div></button>
        <button class="settingBtn" onclick="deleteAccountDemo()"><div class="row"><span>🗑️ <b>Delete Account</b><small class="muted">Permanent deletion will require backend security</small></span><span>›</span></div></button>
      </div>
    </div>
    <div id="dashboard" class="card" style="display:none"></div>
  </div>
</section>
</main>

