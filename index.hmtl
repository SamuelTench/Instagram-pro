</nav>
</div>

<div id="createModal" class="creatorOverlay">
  <div class="creatorStage" style="background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;color:#fff;box-sizing:border-box">
    <button onclick="closeModal()" style="position:absolute;top:18px;right:18px;border:0;border-radius:50%;width:42px;height:42px;font-size:26px;background:#fff;color:#111">×</button>
    <div id="creatorEmoji" style="font-size:64px;margin-bottom:12px">📸</div>
    <h2 id="creatorTitle" style="margin:0 0 8px">Create Post</h2>
    <p id="creatorHint" style="text-align:center;opacity:.8;margin:0 0 24px">Choose Camera or Gallery below.</p>
    <div id="creatorMediaButtons" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%;max-width:360px">
      <button onclick="openNativeCreatorCamera()" style="padding:16px;border:0;border-radius:16px;font-weight:800;font-size:16px">📷 Camera</button>
      <button onclick="openNativeCreatorGallery()" style="padding:16px;border:0;border-radius:16px;font-weight:800;font-size:16px">🖼️ Gallery</button>
    </div>
    <div id="liveCameraPanel" style="display:none;width:100%;max-width:420px;position:relative">
      <video id="liveCameraVideo" autoplay muted playsinline style="width:100%;height:52vh;min-height:360px;object-fit:cover;border-radius:20px;background:#000"></video>
      <div style="position:absolute;top:12px;left:12px;background:#e53935;color:#fff;padding:7px 11px;border-radius:16px;font-weight:800">● LIVE PREVIEW</div>
      <div id="liveCameraStatus" style="text-align:center;margin:10px 0;opacity:.85">Requesting camera and microphone…</div>
      <button id="startLiveBtn" onclick="startActualLive()" style="width:100%;padding:15px;border:0;border-radius:22px;background:#e53935;color:#fff;font-weight:900;font-size:16px">🔴 START LIVE</button>
      <button id="endLiveBtn" onclick="endActualLive()" style="display:none;width:100%;padding:15px;border:0;border-radius:22px;background:#fff;color:#111;font-weight:900;font-size:16px;margin-top:10px">END LIVE</button>
    </div>
    <div id="creatorSelected" style="display:none;width:100%;max-width:360px;margin-top:18px">
      <div id="creatorFileName" style="background:#222;padding:12px;border-radius:12px;margin-bottom:10px"></div>
      <input id="caption" style="width:100%;box-sizing:border-box;padding:12px;border-radius:12px;border:0;margin-bottom:10px" placeholder="Add a caption...">
      <button id="creatorPublish" onclick="publishFromModal()" style="width:100%;padding:14px;border:0;border-radius:20px;font-weight:800">NEXT</button>
    </div>
    <input id="mediaInput" type="file" accept="image/*,video/*" capture="environment" style="display:none" onchange="creatorPickedMedia()">
  </div>
</div>

<div id="storyModal" class="modal">
  <div class="sheet">
    <button style="float:right;border:0;border-radius:50%;width:36px;height:36px" onclick="closeStoryModal()">×</button>
    <h2>Add Story</h2><textarea id="storyText" placeholder="Write something..."></textarea>
    <input id="storyMedia" type="file" accept="image/*,video/*" onchange="previewStory()"><div id="storyPreview"></div>
    <button class="primary" onclick="publishStory()">Post Story</button>
  </div>
</div>
<div id="toast" class="toast"></div>

<script>
const KEY='instagram_pro_v4';
const defaults={
  profile:{name:'Samuel',username:'samuel',bio:'Welcome to my Instagram Pro profile 🚀',followers:['Alex','Jane','Victoria'],following:['Alex','Jane']},
  status:true,theme:'light',
  notifications:[
    {id:101,type:'like',icon:'❤️',actor:'Alex',text:'liked your post',time:Date.now()-3600000,read:false,category:'social'},
    {id:102,type:'comment',icon:'💬',actor:'Jane',text:'commented on your post: Nice! ❤️',time:Date.now()-7200000,read:false,category:'social'},
    {id:103,type:'follow',icon:'👤',actor:'Victoria',text:'started following you',time:Date.now()-10800000,read:true,category:'social'},
    {id:104,type:'mention',icon:'@',actor:'Alex',text:'mentioned you in a story',time:Date.now()-14400000,read:true,category:'social'},
    {id:105,type:'repost',icon:'🔁',actor:'Jane',text:'reposted your Reel',time:Date.now()-18000000,read:true,category:'social'},
    {id:106,type:'message',icon:'💌',actor:'Victoria',text:'sent you a message',time:Date.now()-21600000,read:false,category:'messages'}
  ],
  posts:[
    {id:1,user:'instagram_pro',caption:'Welcome to Instagram Pro 🚀',emoji:'📸',likes:12,liked:false,saved:false,comments:[],media:'',filter:'none',created:Date.now()-50000},
    {id:2,user:'Alex',caption:'New day, new vibes ✨',emoji:'🌅',likes:8,liked:false,saved:false,comments:[{user:'Jane',text:'Nice!'}],media:'',filter:'none',created:Date.now()-40000}
  ],
  stories:[
    {id:11,user:'Alex',text:'Hello 👋',media:''},
    {id:12,user:'Jane',text:'Good vibes ❤️',media:''},
    {id:13,user:'Victoria',text:'✨',media:''}
  ],
  reels:[
    {id:21,user:'Alex',caption:'My first reel 🔥',emoji:'🎬',likes:18,liked:false,saved:false,reposts:0,reposted:false,comments:[],media:'',created:Date.now()-30000},
    {id:22,user:'Victoria',caption:'Weekend vibes ✨',emoji:'💃',likes:9,liked:false,saved:false,reposts:0,reposted:false,comments:[],media:'',created:Date.now()-20000}
  ],
  messageRequests:[{id:501,user:'Chris',text:'Hey! I found your profile 👋',time:Date.now()-1800000}],
  chats:[
    {id:'alex',user:'Alex',messages:[{id:1,from:'Alex',text:'Hey! Welcome to Instagram Pro 👋',time:Date.now()-3600000}]},
    {id:'jane',user:'Jane',messages:[{id:2,from:'Jane',text:'How are you? ❤️',time:Date.now()-7200000}]},
    {id:'victoria',user:'Victoria',messages:[{id:3,from:'Samuel',text:'Hi Victoria!',time:Date.now()-10800000},{id:4,from:'Victoria',text:'Hey 😊',time:Date.now()-10700000}]}
  ]
};
let db=loadDB(), currentChatId=null, editingMessageId=null;
function loadDB(){
  try{
    const x=JSON.parse(localStorage.getItem(KEY));
    const d=structuredClone(defaults);
    const out=x?Object.assign(d,x):d;
    if(!Array.isArray(out.posts)) out.posts=structuredClone(defaults.posts);
    if(!Array.isArray(out.stories)) out.stories=structuredClone(defaults.stories);
    if(!Array.isArray(out.reels)) out.reels=structuredClone(defaults.reels);
    if(!Array.isArray(out.chats)) out.chats=structuredClone(defaults.chats);
    if(!Array.isArray(out.messageRequests)) out.messageRequests=structuredClone(defaults.messageRequests);
    if(!Array.isArray(out.notifications)) out.notifications=structuredClone(defaults.notifications);
    if(!out.profile||typeof out.profile!=='object') out.profile=structuredClone(defaults.profile);
     if(!out.profile.followers||!Array.isArray(out.profile.followers)) out.profile.followers=structuredClone(defaults.profile.followers);
     if(!out.profile.following||!Array.isArray(out.profile.following)) out.profile.following=structuredClone(defaults.profile.following);
    if(typeof out.status!=='boolean') out.status=defaults.status;
    if(!out.theme) out.theme=defaults.theme;
    return out;
  }catch(e){
    return structuredClone(defaults);
  }
}
function saveLocalOnly(){try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){showToast('Local cache is full — large media should use Supabase Storage')}}
function saveDB(){saveLocalOnly();if(window.instagramCloud)window.instagramCloud.queue()} 
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function addNotification(type,actor,text,category='social',icon){
  db.notifications=db.notifications||[];
  db.notifications.unshift({id:Date.now()+Math.random(),type,icon:icon||({like:'❤️',comment:'💬',follow:'👤',mention:'@',repost:'🔁',message:'💌'}[type]||'🔔'),actor:actor||'Someone',text,time:Date.now(),read:false,category});
  db.notifications=db.notifications.slice(0,100);
}
function unreadNotificationCount(){return (db.notifications||[]).filter(n=>!n.read).length}
function updateNotificationBadge(){const b=document.getElementById('notifBadge');if(!b)return;const n=unreadNotificationCount();b.textContent=n>99?'99+':n;b.style.display=n?'flex':'none'}
function timeAgo(t){const sec=Math.max(0,Math.floor((Date.now()-t)/1000));if(sec<60)return 'just now';const min=Math.floor(sec/60);if(min<60)return min+'m';const hr=Math.floor(min/60);if(hr<24)return hr+'h';const d=Math.floor(hr/24);return d+'d'}
let notifFilter='all';
function renderNotifications(){
  const box=document.getElementById('notificationsList');if(!box)return;
  let list=(db.notifications||[]).filter(n=>notifFilter==='all'||n.category===notifFilter);
  if(!list.length){box.innerHTML='<div class="empty">No notifications here yet 🔔</div>';updateNotificationBadge();return}
  box.innerHTML=list.map(n=>`<button class="notifItem ${n.read?'':'unread'}" style="text-align:left;width:100%" onclick="openNotification(${JSON.stringify(n.id)})"><div class="notifIcon">${esc(n.icon||'🔔')}</div><div class="notifText"><div><b>${esc(n.actor||'Someone')}</b> ${esc(n.text||'')}</div><div class="notifTime">${timeAgo(n.time)}${n.read?'':' · New'}</div></div></button>`).join('');
  updateNotificationBadge();
}
function openNotification(id){const n=db.notifications.find(x=>String(x.id)===String(id));if(!n)return;n.read=true;saveDB();renderNotifications();
  if(n.type==='message'){showPage('messages');return}
  if(n.type==='like'||n.type==='comment'){showPage('home');return}
  if(n.type==='repost'){showPage('reels');return}
  if(n.type==='mention'){showPage('home');return}
  if(n.type==='follow'){showPage('profile');return}
}
function markAllNotificationsRead(){(db.notifications||[]).forEach(n=>n.read=true);saveDB();renderNotifications();showToast('All notifications marked as read ✓')}
function setNotifFilter(v){notifFilter=v;renderNotifications()}
function followUser(name){addNotification('follow',name,'started following you','social','👤');saveDB();renderNotifications();showToast('Followed '+name+' 👤')}

function showPage(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  const target=document.getElementById(id);if(!target)return;target.classList.add('active');
  if(id==='home')renderFeed(); if(id==='profile')renderProfile(); if(id==='settings')renderSettings(); if(id==='reels')renderReels(); if(id==='messages')renderChats(); if(id==='notifications')renderNotifications(); if(id==='owner')renderOwnerDashboard();
  window.scrollTo(0,0);
}
function renderStories(){
  const box=document.getElementById('stories'); if(!box)return;
  box.innerHTML='<div class="story"><button onclick="openStoryModal()"><div class="avatar">＋</div><div>Your story</div></button></div>'+
    db.stories.map(s=>`<div class="story"><button onclick="viewStory(${s.id})"><div class="avatar">${esc((s.user||'S')[0].toUpperCase())}</div><div>${esc(s.user)}</div></button></div>`).join('');
}
function storyFilterCSS(f){return f==='vivid'?'saturate(1.65) contrast(1.12)':f==='warm'?'sepia(.28) saturate(1.3)':f==='cool'?'hue-rotate(20deg) saturate(.9)':f==='bw'?'grayscale(1)':'none'}
function openStoryModal(){document.getElementById('storyModal').classList.add('open')}
function previewStoryMedia(e){const f=e.target.files?.[0];if(!f)return;const r=new FileReader();r.onload=()=>{const box=document.getElementById('storyPreview');const old=box.querySelector('img,video');if(old)old.remove();const el=document.createElement(f.type.startsWith('video/')?'video':'img');el.src=r.result;el.controls=f.type.startsWith('video/');el.autoplay=f.type.startsWith('video/');el.muted=true;el.playsInline=true;el.style.cssText='width:100%;height:100%;object-fit:cover';box.prepend(el);document.getElementById('storyPlaceholder').style.display='none';applyStoryPreview()};r.readAsDataURL(f)}
function updateStoryPreview(){const t=document.getElementById('storyText')?.value||'';const m=document.getElementById('storyMentions')?.value.trim()||'';document.getElementById('storyOverlay').textContent=t;const mp=document.getElementById('storyMentionPreview');mp.textContent=m;mp.style.display=m?'block':'none'}
function applyStoryPreview(){const el=document.getElementById('storyPreview')?.querySelector('img,video');if(el)el.style.filter=storyFilterCSS(document.getElementById('storyFilter')?.value||'none');updateStoryPreview()}
function publishStory(){
  const file=document.getElementById('storyMedia')?.files?.[0],text=document.getElementById('storyText')?.value.trim()||'',raw=document.getElementById('storyMentions')?.value||'',music=document.getElementById('storyMusic')?.value||'',filter=document.getElementById('storyFilter')?.value||'none';
  const mentions=(raw.match(/@[A-Za-z0-9_]+/g)||[]);
  const finish=(media)=>{db.stories.unshift({id:Date.now(),user:db.profile.name,text:text||'New story ✨',media:media||'',mentions,music,filter,replies:[],created:Date.now()});db.stories=db.stories.slice(0,30);saveDB();closeModal();renderStories();showToast('Story posted 🎉')};
  if(!file){finish('');return} if(file.size>7*1024*1024){showToast('Choose a media file under 7MB');return} readFile(file).then(finish)
}
function replyToStory(id){const input=document.getElementById('storyReplyInput');const text=input?.value.trim();if(!text)return;const s=db.stories.find(x=>x.id===id);if(!s)return;s.replies=s.replies||[];s.replies.push({user:db.profile.name,text,time:Date.now()});if(s.user!==db.profile.name)addNotification('comment',db.profile.name,'replied to your story: '+text,'social','💬');if(new RegExp('@'+db.profile.username+'\\b','i').test(text))addNotification('mention',db.profile.name,'mentioned you in a story reply','social','@');saveDB();updateNotificationBadge();input.value='';renderStoryReplies(s);showToast('Story reply sent 💬')}
function renderStoryReplies(s){const box=document.getElementById('storyReplies');if(!box)return;box.innerHTML=(s.replies||[]).slice(-8).map(r=>`<div><b>${esc(r.user)}</b>: ${esc(r.text)}</div>`).join('')||'<span class="muted">No replies yet</span>'}
function viewStory(id){const s=db.stories.find(x=>x.id===id);if(!s)return;const media=s.media?(s.media.startsWith('data:video')?`<video controls autoplay playsinline src="${s.media}"></video>`:`<img src="${s.media}">`):`<div style="font-size:32px">${esc(s.text||'Story')}</div>`;openModal(`<div class="storySheet" style="background:#111;color:#fff"><div class="storyPreview" style="background:#111">${media}<div class="storyTextOverlay">${esc(s.text||'')}</div>${s.mentions?.length?`<div class="storyMention">${esc(s.mentions.join(' '))}</div>`:''}</div>${s.music?`<div class="storyMusic">🎵 ${esc(s.music)}</div>`:''}<div class="storyReplyList" id="storyReplies"></div><div class="storyReply"><input id="storyReplyInput" placeholder="Reply to ${esc(s.user)}..." onkeydown="if(event.key==='Enter')replyToStory(${s.id})"><button class="primary" onclick="replyToStory(${s.id})">Send</button></div><button class="setting" style="width:100%;margin-top:8px" onclick="closeModal()">Close</button></div>`);renderStoryReplies(s)}
function mediaHTML(p){
  if(!p.media)return `<div class="placeholderMedia">${esc(p.emoji||'📸')}</div>`;
  return p.media.startsWith('data:video')?`<video class="postMedia" controls playsinline preload="metadata" src="${p.media}"></video>`:`<img class="postMedia filter-${p.filter||'none'}" src="${p.media}" alt="Post">`;
}
function renderFeed(){
  renderStories();
  const q=(document.getElementById('feedSearch').value||'').toLowerCase();
  const posts=db.posts.filter(p=>(p.caption+' '+p.user).toLowerCase().includes(q));
  const feed=document.getElementById('feed');
  if(!posts.length){feed.innerHTML='<div class="empty">No posts found.</div>';return}
  feed.innerHTML=posts.map(p=>`<article class="post">
    <div class="postHead"><div class="mini">${esc((p.user||'S')[0])}</div><div><b>${esc(p.user)}</b><div class="muted">@${esc((p.user||'user').toLowerCase())}</div></div></div>
    ${mediaHTML(p)}
    <div class="actions"><button class="actionBtn ${p.liked?'liked':''}" onclick="toggleLike(${p.id})">${p.liked?'♥':'♡'}</button><button class="actionBtn" onclick="focusComment(${p.id})">💬</button><button class="actionBtn" onclick="sharePost(${p.id})">➤</button><button class="actionBtn" style="margin-left:auto" onclick="toggleSave(${p.id})">${p.saved?'🔖':'▫'}</button></div>
    <div class="caption"><b>${esc(p.user)}</b> ${esc(p.caption)}<div class="muted">${p.likes||0} likes</div></div>
    <div class="comments">${(p.comments||[]).slice(-3).map(c=>`<div class="comment"><b>${esc(c.user)}:</b> ${esc(c.text)}</div>`).join('')}</div>
    <div class="commentBox"><input id="comment-${p.id}" placeholder="Add a comment..." onkeydown="if(event.key==='Enter')addComment(${p.id})"><button onclick="addComment(${p.id})">Post</button></div>
  </article>`).join('');
}
function toggleLike(id){const p=db.posts.find(x=>x.id===id);if(!p)return;p.liked=!p.liked;p.likes=Math.max(0,(p.likes||0)+(p.liked?1:-1));if(p.liked&&p.user!==db.profile.name)addNotification('like',db.profile.name,'liked your post','social','❤️');saveDB();renderFeed();updateNotificationBadge()}
function toggleSave(id){const p=db.posts.find(x=>x.id===id);if(!p)return;p.saved=!p.saved;saveDB();renderFeed();showToast(p.saved?'Post saved 🔖':'Post removed from saved')}
function addComment(id){const input=document.getElementById('comment-'+id);const text=input.value.trim();if(!text)return;const p=db.posts.find(x=>x.id===id);p.comments=p.comments||[];p.comments.push({user:db.profile.name,text});if(p.user!==db.profile.name)addNotification('comment',db.profile.name,'commented on your post: '+text,'social','💬');if(/@(?:samuel|'+db.profile.username+')\b/i.test(text))addNotification('mention',db.profile.name,'mentioned you in a comment','social','@');saveDB();renderFeed();updateNotificationBadge();showToast('Comment added 💬')}
function focusComment(id){const el=document.getElementById('comment-'+id);if(el){el.focus();el.scrollIntoView({behavior:'smooth',block:'center'})}}
async function sharePost(id){const p=db.posts.find(x=>x.id===id);const text=`${p.user}: ${p.caption}`;try{if(navigator.share)await navigator.share({title:'Instagram Pro',text});else if(navigator.clipboard)await navigator.clipboard.writeText(text);showToast('Post shared/copied 📤')}catch(e){showToast('Share cancelled')}}
let creatorMode='reel',creatorStream=null,creatorFacing='environment',creatorRecorder=null,creatorChunks=[],creatorSelectedMedia='',creatorIsRecording=false,creatorMuted=false;
function openCreate(type='post'){
  stopLiveCamera();
  creatorMode=['story','reel','post','live'].includes(type)?type:'post';
  const overlay=document.getElementById('createModal'); overlay.classList.add('show');
  const input=document.getElementById('mediaInput'); input.value='';
  input.accept=creatorMode==='reel'?'video/*':'image/*,video/*';
  if(creatorMode!=='live') input.setAttribute('capture','environment');
  document.getElementById('caption').value='';
  document.getElementById('creatorSelected').style.display='none';
  const titles={story:'Create Story',post:'Create Post',reel:'Create Reel',live:'Go Live'};
  const emojis={story:'📖',post:'📸',reel:'🎬',live:'🔴'};
  document.getElementById('creatorTitle').textContent=titles[creatorMode];
  document.getElementById('creatorEmoji').textContent=emojis[creatorMode];
  const mediaButtons=document.getElementById('creatorMediaButtons');
  const livePanel=document.getElementById('liveCameraPanel');
  if(creatorMode==='live'){
    mediaButtons.style.display='none';
    document.getElementById('creatorSelected').style.display='none';
    livePanel.style.display='block';
    document.getElementById('creatorHint').textContent='Allow camera and microphone, then tap START LIVE.';
    startLiveCamera();
  }else{
    mediaButtons.style.display='grid'; livePanel.style.display='none';
    document.getElementById('creatorHint').textContent='Choose Camera to use your phone camera or Gallery to select existing media.';
  }
}
let liveStream=null,liveStartedAt=0,liveTimer=null;
async function startLiveCamera(){
  const video=document.getElementById('liveCameraVideo'), status=document.getElementById('liveCameraStatus');
  if(!navigator.mediaDevices?.getUserMedia){status.textContent='Camera access is unavailable in this browser. Open the app from HTTPS/Chrome and try again.';return;}
  try{
    liveStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user'},audio:true});
    video.srcObject=liveStream; await video.play();
    status.textContent='Camera and microphone ready.';
  }catch(e){
    status.textContent='Camera/microphone permission was blocked. Allow both permissions and try again.';
  }
}
function startActualLive(){
  if(!liveStream){showToast('Camera and microphone are not ready yet.');return;}
  liveStartedAt=Date.now();
  document.getElementById('startLiveBtn').style.display='none';
  document.getElementById('endLiveBtn').style.display='block';
  document.getElementById('liveCameraStatus').textContent='🔴 LIVE — 00:00';
  clearInterval(liveTimer);
  liveTimer=setInterval(()=>{const sec=Math.floor((Date.now()-liveStartedAt)/1000),m=String(Math.floor(sec/60)).padStart(2,'0'),ss=String(sec%60).padStart(2,'0');document.getElementById('liveCameraStatus').textContent='🔴 LIVE — '+m+':'+ss},1000);
  showToast('You are live 🔴');
}
function endActualLive(){
  const elapsed=liveStartedAt?Math.floor((Date.now()-liveStartedAt)/1000):0;
  stopLiveCamera();
  showToast('Live ended '+Math.floor(elapsed/60)+':'+String(elapsed%60).padStart(2,'0'));
  closeModal();
}
function stopLiveCamera(){
  clearInterval(liveTimer); liveTimer=null;
  if(liveStream){liveStream.getTracks().forEach(t=>t.stop());liveStream=null;}
  const video=document.getElementById('liveCameraVideo'); if(video)video.srcObject=null;
  const start=document.getElementById('startLiveBtn'),end=document.getElementById('endLiveBtn');
  if(start)start.style.display='block'; if(end)end.style.display='none';
}
function openNativeCreatorCamera(){
  const m=document.getElementById('mediaInput');
  if(creatorMode==='reel')m.accept='video/*'; else m.accept='image/*,video/*';
  m.setAttribute('capture','environment');m.click();
}
function openNativeCreatorGallery(){
  const m=document.getElementById('mediaInput');
  m.removeAttribute('capture');m.accept=creatorMode==='reel'?'video/*':'image/*,video/*';m.click();
}
function creatorPickedMedia(){
  const f=document.getElementById('mediaInput').files?.[0];if(!f)return;
  if(creatorMode==='reel'&&!f.type.startsWith('video/')){showToast('Reel needs a video');return;}
  document.getElementById('creatorSelected').style.display='block';
  document.getElementById('creatorFileName').textContent='Selected: '+f.name;
  document.getElementById('creatorPublish').textContent=creatorMode==='live'?'START LIVE':'NEXT';
}
function closeModal(){stopLiveCamera();document.getElementById('createModal').classList.remove('show');const m=document.getElementById('mediaInput');if(m)m.value='';}
async function publishFromModal(){
  const f=document.getElementById('mediaInput').files?.[0],caption=document.getElementById('caption').value.trim();
  if(creatorMode==='live'){if(liveStream){startActualLive();}else{showToast('Start Live after camera and microphone are ready.');}return;}
  if(creatorMode==='reel'&&!f){showToast('Choose a Reel video first.');return;}
  if(!f&&!caption){showToast('Choose media or add text first.');return;}
  if(creatorMode==='story'){
    const media=f?await readFile(f):'';db.stories.unshift({id:Date.now(),user:db.profile.name,text:caption||'New story ✨',media,created:Date.now()});saveDB();closeModal();renderStories();showToast('Story posted 🎉');return;
  }
  if(creatorMode==='reel'){
    let media=await readFile(f);db.reels.unshift({id:Date.now(),user:db.profile.name,caption:caption||'New Reel ✨',emoji:'🎬',likes:0,liked:false,saved:false,reposts:0,reposted:false,comments:[],media,created:Date.now()});saveDB();closeModal();showPage('reels');showToast('Reel published 🎬');return;
  }
  const media=f?await readFile(f):'';db.posts.unshift({id:Date.now(),user:db.profile.name,caption:caption||'New post ✨',emoji:'📸',likes:0,liked:false,saved:false,comments:[],media,created:Date.now()});saveDB();closeModal();showPage('home');showToast('Post published 🎉');
}
function createFromQuick(){
  const f=document.getElementById('quickMedia').files[0],caption=document.getElementById('quickCaption').value.trim();
  if(!caption&&!f){showToast('Add something to your post');return}
  readFile(f).then(media=>{db.posts.unshift({id:Date.now(),user:db.profile.name,caption:caption||'New post ✨',emoji:'📸',likes:0,liked:false,saved:false,comments:[],media:media||'',filter:'none',created:Date.now()});saveDB();document.getElementById('quickCaption').value='';document.getElementById('quickMedia').value='';showPage('home');showToast('Post published 🎉')})
}
function readFile(file){return new Promise(resolve=>{if(!file)return resolve('');const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=()=>resolve('');r.readAsDataURL(file)})}
function renderReels(){
  normalizeReels();
  const box=document.getElementById('reelsFeed');
  if(!db.reels.length){box.innerHTML='<div class="empty">No Reels yet. Create your first one 🎬</div>';return}
  box.innerHTML=db.reels.map(r=>`<article class="reel">
    ${r.media?`<video playsinline controls preload="metadata" src="${r.media}"></video>`:`<div class="placeholderMedia" style="height:650px">${esc(r.emoji||'🎬')}</div>`}
    <div class="reelShade"></div>
    <div class="reelInfo"><h3>@${esc(r.user)}</h3><p>${esc(r.caption)}</p></div>
    <div class="reelActions"><button onclick="toggleReelLike(${r.id})">${r.liked?'♥':'♡'}</button><small>${r.likes||0}</small><button onclick="focusReelComment(${r.id})">💬</button><button onclick="repostReel(${r.id})">${r.reposted?'🔁':'↻'}</button><small>${r.reposts||0}</small><button onclick="toggleReelSave(${r.id})">${r.saved?'🔖':'🔖'}</button><button onclick="shareReel(${r.id})">➤</button></div>
  </article>`).join('');
}
function normalizeReels(){(db.reels||[]).forEach(r=>{if(typeof r.saved!=='boolean')r.saved=false;if(typeof r.reposted!=='boolean')r.reposted=false;if(typeof r.reposts!=='number')r.reposts=0})}
function toggleReelLike(id){const r=db.reels.find(x=>x.id===id);if(!r)return;r.liked=!r.liked;r.likes=Math.max(0,(r.likes||0)+(r.liked?1:-1));saveDB();renderReels()}
function toggleReelSave(id){const r=db.reels.find(x=>x.id===id);if(!r)return;r.saved=!r.saved;saveDB();renderReels();showToast(r.saved?'Reel saved 🔖':'Removed from saved')}
function repostReel(id){const r=db.reels.find(x=>x.id===id);if(!r)return;r.reposted=!r.reposted;r.reposts=Math.max(0,(r.reposts||0)+(r.reposted?1:-1));if(r.reposted&&r.user!==db.profile.name)addNotification('repost',db.profile.name,'reposted your Reel','social','🔁');saveDB();renderReels();updateNotificationBadge();showToast(r.reposted?'Reel reposted 🔁':'Repost removed')}
async function shareReel(id){const r=db.reels.find(x=>x.id===id);try{if(navigator.share)await navigator.share({title:'Instagram Pro Reel',text:`${r.user}: ${r.caption}`});else if(navigator.clipboard)await navigator.clipboard.writeText(`${r.user}: ${r.caption}`);showToast('Reel shared/copied 📤')}catch(e){showToast('Share cancelled')}}
function focusReelComment(id){const r=db.reels.find(x=>x.id===id);const text=prompt(`Comment on ${r.user}'s Reel:`);if(text&&text.trim()){r.comments=r.comments||[];r.comments.push({user:db.profile.name,text:text.trim()});saveDB();showToast('Reel comment added 💬')}}
function closeStoryModal(){document.getElementById('storyModal').classList.remove('open');document.getElementById('storyText').value='';document.getElementById('storyMedia').value='';document.getElementById('storyPreview').innerHTML=''}
function previewStory(){const f=document.getElementById('storyMedia').files[0];if(!f)return;readFile(f).then(x=>document.getElementById('storyPreview').innerHTML=f.type.startsWith('video')?`<video class="preview" controls playsinline src="${x}"></video>`:`<img class="preview" src="${x}">`)}
function renderSearch(){
  const input=document.getElementById('globalSearch');
  const box=document.getElementById('searchResults');
  if(!input||!box)return;
  const q=(input.value||'').trim().toLowerCase();
  const posts=db.posts||[], reels=db.reels||[], stories=db.stories||[], chats=db.chats||[];
  const users=[...new Set([
    ...posts.map(p=>p.user),...reels.map(r=>r.user),...stories.map(s=>s.user),...chats.map(c=>c.user),db.profile?.name
  ].filter(Boolean))];
  if(!q){
    box.innerHTML=`<div class="card"><b>🔎 Search Instagram Pro</b><p class="muted">Find users, posts, Reels and conversations.</p></div>
      <div class="card"><b>👥 People</b><p class="muted">Try searching for Alex, Jane, Victoria or another username.</p></div>`;
    return;
  }
  const people=users.filter(u=>u.toLowerCase().includes(q));
  const postMatches=posts.filter(p=>(String(p.caption||'')+' '+String(p.user||'')).toLowerCase().includes(q));
  const reelMatches=reels.filter(r=>(String(r.caption||'')+' '+String(r.user||'')).toLowerCase().includes(q));
  const chatMatches=chats.filter(c=>String(c.user||'').toLowerCase().includes(q)||c.messages?.some(m=>String(m.text||'').toLowerCase().includes(q)));
  let html='';
  if(people.length) html+=`<h3>People</h3>`+people.map(u=>`<button class="card searchResult" onclick="openSearchUser(${JSON.stringify(u)})"><b>👤 ${esc(u)}</b><p class="muted">@${esc(u.toLowerCase().replace(/\\s+/g,''))} · Creator on Instagram Pro</p></button>`).join('');
  if(postMatches.length) html+=`<h3>Posts</h3>`+postMatches.map(p=>`<button class="card searchResult" onclick="openSearchPost(${p.id})"><b>📸 ${esc(p.user)}</b><p>${esc(p.caption||'')}</p><small class="muted">${p.likes||0} likes</small></button>`).join('');
  if(reelMatches.length) html+=`<h3>Reels</h3>`+reelMatches.map(r=>`<button class="card searchResult" onclick="openSearchReel(${r.id})"><b>🎬 ${esc(r.user)}</b><p>${esc(r.caption||'')}</p><small class="muted">${r.likes||0} likes</small></button>`).join('');
  if(chatMatches.length) html+=`<h3>Messages</h3>`+chatMatches.map(c=>`<button class="card searchResult" onclick="openSearchChat(${JSON.stringify(c.id)})"><b>💬 ${esc(c.user)}</b><p class="muted">${esc((c.messages?.[c.messages.length-1]?.text)||'Conversation')}</p></button>`).join('');
  box.innerHTML=html||'<div class="empty">No results found. Try another name or word.</div>';
}
function openSearchUser(name){
  showPage('profile');
  showToast('User profile selected: '+name);
}
function openSearchPost(id){
  showPage('home');
  const input=document.getElementById('feedSearch');
  const p=db.posts.find(x=>x.id===id);
  if(p&&input){input.value=p.user;renderFeed();setTimeout(()=>document.querySelector('.post')?.scrollIntoView({behavior:'smooth',block:'start'}),80);}
}
function openSearchReel(id){
  showPage('reels');
  const r=db.reels.find(x=>x.id===id);
  if(r) toast('Reel by '+r.user);
}
function openSearchChat(id){
  showPage('messages');
  openChat(id);
}
function toggleOwnFollow(){db.follows=db.follows||{following:false,followers:0,followingCount:0};db.follows.following=!db.follows.following;db.follows.followingCount=db.follows.following?1:0;saveDB();renderProfile();showToast(db.follows.following?'Following ✓':'Unfollowed');}
function renderOwnerDashboard(){
 const posts=db.posts||[], reels=db.reels||[], chats=db.chats||[], reqs=db.messageRequests||[], notifs=db.notifications||[];
 const users=[...new Set([...posts.map(x=>x.user),...reels.map(x=>x.user),...chats.map(x=>x.user),...((db.stories||[]).map(x=>x.user)),db.profile?.name].filter(Boolean))];
 const views=posts.reduce((a,p)=>a+5+(p.likes||0),0)+(reels.reduce((a,r)=>a+8+(r.likes||0),0));
 const earnings=(views*.25).toFixed(2);
 const stats=document.getElementById('ownerStats'); if(stats)stats.innerHTML=`<div class="stat"><b>${users.length}</b><span>Users</span></div><div class="stat"><b>${posts.length}</b><span>Posts</span></div><div class="stat"><b>${reels.length}</b><span>Reels</span></div><div class="stat"><b>KSh ${earnings}</b><span>Demo earnings</span></div>`;
 const ov=document.getElementById('ownerOverview'); if(ov)ov.innerHTML=`<p>👀 Estimated views: <b>${views}</b></p><p>📩 Message requests: <b>${reqs.length}</b></p><p>🔔 Notifications: <b>${notifs.length}</b></p><p>💬 Conversations: <b>${chats.length}</b></p><p>📸 Stories: <b>${(db.stories||[]).length}</b></p>`;
 const u=document.getElementById('ownerUsers'); if(u)u.innerHTML=users.map(name=>`<div class="listRow"><span>👤 <b>${esc(name)}</b></span><span class="muted">${name===db.profile.name?'Owner':'User'}</span></div>`).join('');
 const m=document.getElementById('ownerMaintenance'); if(m)m.textContent=db.owner?.maintenance?'⚠️ Maintenance mode is ON':'Maintenance mode is OFF';
}
function ownerAnnouncement(){const t=prompt('Owner announcement:');if(t&&t.trim()){db.owner=db.owner||{};db.owner.announcement=t.trim();addNotification('announcement','Owner',t.trim(),'social','📢');saveDB();renderOwnerDashboard();showToast('Announcement created 📢')}}
function ownerToggleMaintenance(){db.owner=db.owner||{};db.owner.maintenance=!db.owner.maintenance;saveDB();renderOwnerDashboard();showToast(db.owner.maintenance?'Maintenance mode ON':'Maintenance mode OFF')}
function ownerResetDemo(){if(confirm('Reset demo posts, messages and activity? Your profile/settings may remain.')){db.posts=structuredClone(defaults.posts);db.reels=structuredClone(defaults.reels);db.stories=structuredClone(defaults.stories);db.chats=structuredClone(defaults.chats);db.notifications=structuredClone(defaults.notifications);db.messageRequests=structuredClone(defaults.messageRequests||[]);saveDB();renderOwnerDashboard();showToast('Demo data reset')}}
function renderProfile(){
  const prof=db.profile||{};
  const followers=Array.isArray(prof.followers)?prof.followers:[];
  const following=Array.isArray(prof.following)?prof.following:[];
  document.getElementById('profileName').textContent=prof.name||'Samuel';
  const pu=document.getElementById('profileUsername'); if(pu)pu.textContent='@'+String(prof.username||'samuel').replace(/^@/,'');
  document.getElementById('profileBio').textContent=prof.bio||'';
  const mine=db.posts.filter(p=>p.user===prof.name);
  document.getElementById('profileFollowers').textContent=followers.length;
  document.getElementById('profileFollowing').textContent=following.length;
  document.getElementById('profilePosts').textContent=mine.length;
  document.getElementById('profileLikes').textContent=mine.reduce((a,p)=>a+(p.likes||0),0);
  document.getElementById('profileGrid').innerHTML=mine.length?mine.map(p=>`<div class="gridItem">${p.media?(p.media.startsWith('data:video')?`<video src="${p.media}"></video>`:`<img src="${p.media}">`):esc(p.emoji||'📸')}</div>`).join(''):'<div class="empty" style="grid-column:1/4">No posts yet</div>';
}
function showFollowList(type){
  const panel=document.getElementById('followListPanel'); if(!panel)return;
  const list=(db.profile&&Array.isArray(db.profile[type]))?db.profile[type]:[];
  panel.style.display='block';
  panel.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center"><h3 style="margin:0">${type==='followers'?'Followers':'Following'} (${list.length})</h3><button class="iconBtn" onclick="document.getElementById('followListPanel').style.display='none'">×</button></div><div class="followList" style="margin-top:10px">${list.length?list.map(name=>`<div class="followCard"><div class="mini">${esc((name||'U')[0].toUpperCase())}</div><div class="followCardInfo"><b>${esc(name)}</b><div class="muted">@${esc(String(name).toLowerCase().replace(/\s+/g,''))}</div></div>${type==='following'?`<button class="following" onclick="toggleFollow('${esc(name)}')">Following</button>`:`<button onclick="openSearchUser(${JSON.stringify(name)})">View</button>`}</div>`).join(''):'<div class="empty">No ${type} yet.</div>'}</div>`;
  panel.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function toggleFollow(name){
  const prof=db.profile; prof.following=Array.isArray(prof.following)?prof.following:[];
  const i=prof.following.indexOf(name);
  if(i>=0){prof.following.splice(i,1);showToast('Unfollowed '+name);}
  else{prof.following.push(name);addNotification('follow',name,'started following you','social','👤');showToast('Following '+name+' 👤');}
  saveDB();renderProfile();showFollowList('following');updateNotificationBadge();
}
async function editProfile(){const n=prompt('Display name:',db.profile.name);if(!n||!n.trim())return;db.profile.name=n.trim();const u=prompt('Username:',db.profile.username||'samuel');if(u&&u.trim())db.profile.username=u.trim().replace(/^@/,'');const b=prompt('Bio:',db.profile.bio);if(b!==null)db.profile.bio=b.trim();saveLocalOnly();renderProfile();renderFeed();if(window.instagramCloud){window.instagramCloud.userId=window.instagramCloud.userId||null;const ok=await window.instagramCloud.save(true);const profileOk=await upsertCloudProfile();showToast(ok&&profileOk?'Profile saved to Supabase ☁️':'Profile saved locally — cloud save failed');}else{showToast('Profile updated ✨')}}
function toggleStatus(){db.status=!db.status;saveDB();renderSettings();showToast(db.status?'Activity status ON':'Activity status OFF')}
function setTheme(v){db.theme=v;saveDB();applyTheme();showToast(v==='dark'?'Dark mode on 🌙':'Light mode on ☀️')}
function applyTheme(){document.documentElement.classList.toggle('dark',db.theme==='dark');const s=document.getElementById('themeSelect');if(s)s.value=db.theme}

function ensureSettings(){db.settings=db.settings||{};const st=db.settings;st.twoFactor=!!st.twoFactor;st.readReceipts=st.readReceipts!==false;st.push=st.push!==false;st.likes=st.likes!==false;st.social=st.social!==false;st.messages=st.messages!==false;st.dataSaver=!!st.dataSaver;st.privateAccount=!!st.privateAccount;st.messageWho=st.messageWho||'Everyone';st.commentWho=st.commentWho||'Everyone';st.mentionWho=st.mentionWho||'Everyone';return st}
function setToggle(id,on){const e=document.getElementById(id);if(e)e.classList.toggle('on',!!on)}
function renderExtraSettings(){const st=ensureSettings();setToggle('twoFactorToggle',st.twoFactor);setToggle('readReceiptToggle',st.readReceipts);setToggle('pushToggle',st.push);setToggle('likeNotifToggle',st.likes);setToggle('socialNotifToggle',st.social);setToggle('messageNotifToggle',st.messages);setToggle('dataSaverToggle',st.dataSaver);setToggle('privateToggle',st.privateAccount)}
function toggleTwoFactor(){const st=ensureSettings();st.twoFactor=!st.twoFactor;saveDB();renderExtraSettings();showToast(st.twoFactor?'Two-factor authentication enabled 🔐':'Two-factor authentication disabled')}
function toggleReadReceipts(){const st=ensureSettings();st.readReceipts=!st.readReceipts;saveDB();renderExtraSettings();showToast(st.readReceipts?'Read receipts ON':'Read receipts OFF')}
function toggleSetting(k){const st=ensureSettings();st[k]=!st[k];saveDB();renderExtraSettings();showToast((k==='dataSaver'?'Data Saver':k+' notifications')+(st[k]?' ON':' OFF'))}
function togglePrivateAccount(){const st=ensureSettings();st.privateAccount=!st.privateAccount;db.profile.private=st.privateAccount;saveDB();renderExtraSettings();showToast(st.privateAccount?'Private account ON 🔒':'Private account OFF')}
function changePasswordDemo(){const a=prompt('Enter current password (demo):');if(a===null)return;const b=prompt('Enter new password:');if(b&&b.length>=6)showToast('Password changed in demo 🔑');else showToast('Password must be at least 6 characters')}
function showLoginActivity(){showToast('Current device: Android • Active now 📱')}
function logoutAllDemo(){if(confirm('Log out of all other devices?'))showToast('Other sessions signed out 🚪')}
function privacyChoices(){const st=ensureSettings();const v=prompt('Who can message you? Enter Everyone, Followers, or Nobody.',st.messageWho);if(v&&['Everyone','Followers','Nobody'].includes(v)){st.messageWho=v;saveDB();showToast('Message privacy: '+v)}}
function commentChoices(){const st=ensureSettings();const v=prompt('Who can comment? Enter Everyone, Followers, or Nobody.',st.commentWho);if(v&&['Everyone','Followers','Nobody'].includes(v)){st.commentWho=v;saveDB();showToast('Comment privacy: '+v)}}
function tagMentionChoices(){const st=ensureSettings();const v=prompt('Who can mention/tag you? Enter Everyone, Followers, or Nobody.',st.mentionWho);if(v&&['Everyone','Followers','Nobody'].includes(v)){st.mentionWho=v;saveDB();showToast('Mention/tag privacy: '+v)}}
function showContentPrefs(){showToast('Hidden words controls opened 🚫')}
function showMutedAccounts(){showToast('No muted accounts yet 🔇')}
function downloadInfoDemo(){const data=JSON.stringify(db,null,2);const blob=new Blob([data],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='instagram-pro-my-data.json';a.click();URL.revokeObjectURL(a.href);showToast('Your demo data downloaded 📥')}
function deactivateDemo(){if(confirm('Deactivate this demo account?')){db.profile.deactivated=true;saveDB();showToast('Account marked as deactivated ⏸️')}}
async function deleteAccountDemo(){if(!confirm('Delete your app data? This cannot be undone.'))return;try{if(window.supabaseClient){const session=await instagramCloud.session();if(session){const {error}=await window.supabaseClient.from('app_state').delete().eq('user_id',session.user.id);if(error)throw error;await window.supabaseClient.auth.signOut()}}}catch(e){showToast('Cloud deletion failed: '+(e.message||'check RLS'));return}localStorage.removeItem(KEY);db=structuredClone(defaults);showToast('Account data deleted. 🔐');setTimeout(()=>location.reload(),700)}
function renderSettings(){document.getElementById('statusToggle').classList.toggle('on',!!db.status);document.getElementById('themeSelect').value=db.theme;applyTheme();renderExtraSettings()}
function filterSettings(q){q=q.toLowerCase();document.querySelectorAll('.settingGroup').forEach(g=>g.style.display=g.innerText.toLowerCase().includes(q)?'block':'none')}
function showDashboard(){const d=document.getElementById('dashboard');d.style.display='block';const views=db.posts.reduce((a,p)=>a+5+(p.likes||0),0);const earnings=(views*.25).toFixed(2);d.innerHTML=`<h3>📊 Dashboard & Earnings</h3><p><b>${views}</b> estimated views</p><p><b>${db.posts.length}</b> posts</p><p><b>${db.reels.length}</b> reels</p><p><b>KSh ${earnings}</b> demo earnings</p><small class="muted">Prototype calculation only. Real payments need a backend and payment provider.</small>`;d.scrollIntoView({behavior:'smooth'})}

function renderMessageRequests(){
  const box=document.getElementById('messageRequestsPanel'),badge=document.getElementById('requestBadge');
  if(!box||!badge)return;
  const reqs=db.messageRequests||[]; badge.textContent=reqs.length; badge.style.display=reqs.length?'inline-block':'none';
  box.innerHTML=reqs.length?reqs.map(r=>`<div class="requestCard"><div class="mini">${esc((r.user||'U')[0].toUpperCase())}</div><div><b>${esc(r.user)}</b><div class="muted">${esc(r.text||'Wants to message you')}</div><small class="muted">${timeAgo(r.time)}</small></div><div class="requestActions"><button class="acceptReq" onclick="acceptMessageRequest(${r.id})">Accept</button><button class="declineReq" onclick="declineMessageRequest(${r.id})">Delete</button></div></div>`).join(''):'<div class="empty">No message requests 📭</div>';
}
function toggleMessageRequests(){const p=document.getElementById('messageRequestsPanel');if(!p)return;p.style.display=p.style.display==='none'?'block':'none';renderMessageRequests()}
function acceptMessageRequest(id){const r=(db.messageRequests||[]).find(x=>x.id===id);if(!r)return;db.messageRequests=db.messageRequests.filter(x=>x.id!==id);let c=db.chats.find(x=>x.user===r.user);if(!c){c={id:'req_'+id,user:r.user,messages:[]};db.chats.unshift(c)}c.messages.push({id:Date.now(),from:r.user,text:r.text,time:r.time});addNotification('message',r.user,'request accepted','messages','💬');saveDB();renderMessageRequests();renderChats();showToast('Message request accepted ✅')}
function declineMessageRequest(id){const r=(db.messageRequests||[]).find(x=>x.id===id);db.messageRequests=(db.messageRequests||[]).filter(x=>x.id!==id);if(r)addNotification('message',r.user,'message request deleted','messages','📩');saveDB();renderMessageRequests();showToast('Message request deleted')}
function sendMessageRequest(user,text){db.messageRequests=db.messageRequests||[];db.messageRequests.unshift({id:Date.now(),user,text:text||'Hi 👋',time:Date.now()});saveDB();renderMessageRequests()}
function renderChats(){
  renderMessageRequests();
  const q=(document.getElementById('messageSearch').value||'').toLowerCase();
  const list=db.chats.filter(c=>c.user.toLowerCase().includes(q)||c.messages.some(m=>m.text.toLowerCase().includes(q)));
  document.getElementById('chatList').innerHTML=list.length?list.map(c=>{
    const last=c.messages[c.messages.length-1];
    return `<div class="chatItem"><div class="mini">${esc(c.user[0])}</div><button onclick="openChat('${c.id}')"><b>${esc(c.user)}</b><div class="muted">${esc(last?.text||'No messages yet')}</div></button><span class="muted">${last?formatTime(last.time):''}</span></div>`
  }).join(''):'<div class="empty">No conversations found.</div>';
}
function openChat(id){currentChatId=id;document.getElementById('chatListView').style.display='none';document.getElementById('chatWindowView').style.display='block';renderChatWindow();setTimeout(()=>document.getElementById('messageInput').focus(),100)}
function closeChat(){currentChatId=null;document.getElementById('chatWindowView').style.display='none';document.getElementById('chatListView').style.display='block';renderChats()}
function renderChatWindow(){
  const c=db.chats.find(x=>x.id===currentChatId);if(!c)return;
  document.getElementById('chatName').textContent=c.user;document.getElementById('chatAvatar').textContent=c.user[0].toUpperCase();document.getElementById('chatStatus').textContent=db.status?'Active now':'Activity status off';
  const box=document.getElementById('chatMessages');
  box.innerHTML=c.messages.map(m=>{
    const mine=m.from===db.profile.name;
    let body='';
    if(m.type==='media' && m.media){body=m.media.startsWith('data:video')?`<video class="messageMedia" controls playsinline src="${m.media}"></video>`:`<img class="messageMedia" src="${m.media}">`;}
    else if(m.type==='voice' && m.media){body=`<div class="voiceMsg">🎤 <audio controls src="${m.media}"></audio></div>`;}
    else body=`<div>${esc(m.text||'')}</div>`;
    const reaction=m.reaction||'';
    const privateMsg=m.viewMode==='once'||m.viewMode==='twice';
    if(m.expired){ body=`<div class="privateExpired">🔒 Private message expired</div>`; }
    let privateBody=body;
    if(privateMsg && !m.revealed){
      const left=Math.max(0,m.viewsLeft ?? (m.viewMode==='once'?1:2));
      privateBody=`<button class="privateMsg" onclick="openPrivateMessage(${m.id})">🔒 ${m.viewMode==='once'?'View once':'View twice'} · ${left} view${left===1?'':'s'} left</button>`;
    }
    return `<div class="bubbleRow ${mine?'mine':''}"><div class="bubble">${privateBody}<div class="reactionRow"><button class="reactionBtn" onclick="reactToMessage(${m.id})">${reaction||'♡'}</button>${reaction?'<span class="reactionCount">1</span>':''}</div><div class="bubbleMeta">${formatTime(m.time)} ${privateMsg?`<span>🔐 ${m.viewMode==='once'?'view once':'view twice'}</span>`:''} ${mine&&!m.type?`<button class="bubbleMenu" onclick="editMessage(${m.id})">Edit</button>`:''}${mine?`<button class="bubbleMenu" onclick="deleteMessage(${m.id})">Delete</button>`:''}</div></div></div>`;
  }).join('') || '<div class="empty">Start the conversation 💬</div>';
  box.scrollTop=box.scrollHeight;
}
function formatTime(t){return new Date(t).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}
function sendMessage(){
  const input=document.getElementById('messageInput'),text=input.value.trim();if(!text||!currentChatId)return;
  const c=db.chats.find(x=>x.id===currentChatId);if(!c)return;
  if(editingMessageId){const m=c.messages.find(x=>x.id===editingMessageId);if(m&&m.from===db.profile.name)m.text=text;editingMessageId=null;showToast('Message edited ✏️')}
  else{
    const mode=document.getElementById('messageViewMode')?.value||'normal';
    c.messages.push({id:Date.now(),from:db.profile.name,text,time:Date.now(),type:'text',viewMode:mode,viewsLeft:mode==='once'?1:mode==='twice'?2:null,revealed:false});
    if(c.user!==db.profile.name)addNotification('message',db.profile.name,'sent you a message','messages','💌');
    if(new RegExp('@'+db.profile.username+'\\b','i').test(text))addNotification('mention',db.profile.name,'mentioned you in a message','messages','@');
    showToast(mode==='once'?'View-once message sent 🔐':mode==='twice'?'View-twice message sent 🔐':'Message sent 💬');
  }
  input.value='';if(document.getElementById('messageViewMode'))document.getElementById('messageViewMode').value='normal';saveDB();renderChatWindow();
}

function openPrivateMessage(id){
  const c=db.chats.find(x=>x.id===currentChatId),m=c?.messages.find(x=>x.id===id);
  if(!m||!m.viewMode)return;
  const left=m.viewsLeft ?? (m.viewMode==='once'?1:2);
  if(left<=0){showToast('This private message has expired 🔒');return;}
  m.revealed=true;
  m.viewsLeft=left-1;
  saveDB();
  renderChatWindow();
  if(m.viewsLeft<=0){
    setTimeout(()=>{
      const cc=db.chats.find(x=>x.id===currentChatId);
      const mm=cc?.messages.find(x=>x.id===id);
      if(mm){mm.expired=true;mm.revealed=false;saveDB();renderChatWindow();showToast('Private message expired 🔒');}
    },3500);
  }else{
    setTimeout(()=>{
      const cc=db.chats.find(x=>x.id===currentChatId);
      const mm=cc?.messages.find(x=>x.id===id);
      if(mm&&!mm.expired){mm.revealed=false;saveDB();renderChatWindow();}
    },3500);
  }
}
function editMessage(id){const c=db.chats.find(x=>x.id===currentChatId),m=c?.messages.find(x=>x.id===id);if(!m||m.from!==db.profile.name||m.type==='media'||m.type==='voice')return;editingMessageId=id;document.getElementById('messageInput').value=m.text;document.getElementById('messageInput').focus();showToast('Edit the message and press Send')}
function deleteMessage(id){const c=db.chats.find(x=>x.id===currentChatId);if(!c)return;c.messages=c.messages.filter(m=>m.id!==id);saveDB();renderChatWindow();showToast('Message deleted 🗑️')}
function reactToMessage(id){const c=db.chats.find(x=>x.id===currentChatId),m=c?.messages.find(x=>x.id===id);if(!m)return;m.reaction=m.reaction?'':'❤️';saveDB();renderChatWindow()}
function sendChatMedia(input){const f=input.files&&input.files[0];if(!f||!currentChatId)return;readFile(f).then(media=>{if(!media)return;const c=db.chats.find(x=>x.id===currentChatId);if(!c)return;c.messages.push({id:Date.now(),from:db.profile.name,text:'',media,type:'media',time:Date.now()});saveDB();renderChatWindow();showToast(f.type.startsWith('video')?'Video sent 🎬':'Photo sent 📷');input.value=''})}
let voiceRecorder=null,voiceChunks=[];
async function toggleVoiceRecording(){
  const btn=document.getElementById('voiceBtn');
  if(voiceRecorder&&voiceRecorder.state==='recording'){voiceRecorder.stop();btn.textContent='🎤';btn.style.background='#eee';showToast('Finishing voice message…');return}
  if(!navigator.mediaDevices?.getUserMedia||!window.MediaRecorder){showToast('Voice recording is not available here');return}
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    voiceChunks=[];voiceRecorder=new MediaRecorder(stream);
    voiceRecorder.ondataavailable=e=>{if(e.data.size)voiceChunks.push(e.data)};
    voiceRecorder.onstop=()=>{const blob=new Blob(voiceChunks,{type:voiceRecorder.mimeType||'audio/webm'});stream.getTracks().forEach(t=>t.stop());const reader=new FileReader();reader.onload=()=>{const c=db.chats.find(x=>x.id===currentChatId);if(!c)return;c.messages.push({id:Date.now(),from:db.profile.name,text:'',media:reader.result,type:'voice',time:Date.now()});saveDB();renderChatWindow();showToast('Voice message sent 🎤')};reader.readAsDataURL(blob)};
    voiceRecorder.start();btn.textContent='⏹️';btn.style.background='#e31b23';showToast('Recording… tap again to stop');
  }catch(e){showToast('Microphone permission was not granted')}
}
function showToast(t){const x=document.getElementById('toast');x.textContent=t;x.style.display='block';clearTimeout(window._toast);window._toast=setTimeout(()=>x.style.display='none',1900)}

window.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden'&&window.instagramCloud?.userId){window.instagramCloud.save(true)}});
window.addEventListener('pagehide',()=>{if(window.instagramCloud?.userId){window.instagramCloud.save(true)}});
if(window.supabaseClient){window.supabaseClient.auth.onAuthStateChange((_event,session)=>{if(session){setTimeout(()=>window.instagramCloud.load(),0)}})}
applyTheme();renderFeed();renderReels();updateNotificationBadge();setTimeout(()=>syncCurrentUserFromSupabase(),50);
</script>

<!-- Supabase Login / Sign Up -->
<div id="supabaseLoginModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:10000;align-items:center;justify-content:center;padding:20px">
 <div style="background:#fff;border-radius:22px;padding:24px;max-width:420px;width:100%;box-sizing:border-box">
  <h2 style="margin:0 0 6px">Instagram Pro Login</h2>
  <p style="color:#666;margin:0 0 18px">Sign in with your Supabase account.</p>
  <input id="supabaseLoginEmail" type="email" placeholder="Email" autocomplete="email" style="width:100%;box-sizing:border-box;padding:13px;margin:6px 0;border:1px solid #ddd;border-radius:12px">
  <input id="supabaseLoginPassword" type="password" placeholder="Password" autocomplete="current-password" style="width:100%;box-sizing:border-box;padding:13px;margin:6px 0;border:1px solid #ddd;border-radius:12px">
  <input id="supabaseLoginUsername" type="text" placeholder="Username (only for new account)" autocomplete="username" style="width:100%;box-sizing:border-box;padding:13px;margin:6px 0;border:1px solid #ddd;border-radius:12px">
  <div style="display:flex;gap:10px;margin-top:12px">
   <button onclick="supabaseLogin(false)" style="flex:1;padding:13px;border:0;border-radius:12px;background:#0095f6;color:#fff;font-weight:700">Log in</button>
   <button onclick="supabaseLogin(true)" style="flex:1;padding:13px;border:0;border-radius:12px;background:#eee;font-weight:700">Create account</button>
  </div>
  <button onclick="closeSupabaseLogin()" style="width:100%;margin-top:10px;padding:10px;border:0;background:none">Cancel</button>
  <p id="supabaseLoginStatus" style="font-size:13px;color:#666;min-height:18px"></p>
 </div>
</div>
<script>
function openSupabaseLogin(){const m=document.getElementById('supabaseLoginModal');if(m)m.style.display='flex'}
function closeSupabaseLogin(){const m=document.getElementById('supabaseLoginModal');if(m)m.style.display='none'}
async function supabaseLogin(createAccount){
 const email=document.getElementById('supabaseLoginEmail').value.trim();
 const password=document.getElementById('supabaseLoginPassword').value;
 const username=document.getElementById('supabaseLoginUsername').value.trim();
 const status=document.getElementById('supabaseLoginStatus');
 if(!email||!password){status.textContent='Enter your email and password.';return}
 if(createAccount && !username){status.textContent='Enter a username for the new account.';return}
 status.textContent='Connecting to Supabase…';
 try{
  const result=createAccount ? await signUpOnline(email,password,username,username) : await signInOnline(email,password);
  if(result.error) throw result.error;
  if(createAccount && !result.data?.session){status.textContent='Account created. Check your email to confirm it, then log in.';return}
  if(createAccount&&result.data?.session){
    db.profile.name=username||db.profile.name;db.profile.username=username||db.profile.username;
    await upsertCloudProfile();
  }
  status.textContent=createAccount?'Account created and signed in!':'Logged in successfully!';
  await window.instagramCloud.load();
  setTimeout(closeSupabaseLogin,800);
 }catch(e){status.textContent=e?.message||'Login failed. Check your email and password.'}
}
</script>

<!-- Meta Login integration scaffold -->
<div id="metaLoginModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:9999;align-items:center;justify-content:center;padding:20px">
 <div style="background:#fff;border-radius:22px;padding:28px;max-width:420px;width:100%;text-align:center">
  <div style="font-size:42px">🔵</div><h2>Continue with Meta</h2>
  <p style="color:#666">Connect your Meta account securely. The button below is a setup placeholder until your Meta app ID and hosted redirect URL are configured.</p>
  <button onclick="startMetaLogin()" style="width:100%;padding:14px;border:0;border-radius:12px;background:#1877f2;color:#fff;font-weight:700">Continue with Meta</button>
  <button onclick="closeMetaLogin()" style="margin-top:10px;border:0;background:none;padding:10px">Cancel</button>
  <p id="metaLoginStatus" style="font-size:13px;color:#777"></p>
 </div>
</div>
<script>
const META_CONFIG={
 appId:'YOUR_META_APP_ID',
 redirectUri:'https://YOUR-DOMAIN.example.com/auth/meta/callback',
 version:'vXX.X',
 scopes:[]
};
function openMetaLogin(){const m=document.getElementById('metaLoginModal');if(m)m.style.display='flex'}
function closeMetaLogin(){const m=document.getElementById('metaLoginModal');if(m)m.style.display='none'}
function startMetaLogin(){
 const st=document.getElementById('metaLoginStatus');
 if(META_CONFIG.appId==='YOUR_META_APP_ID'||META_CONFIG.redirectUri.includes('YOUR-DOMAIN')){
  st.textContent='Setup needed: create a Meta app, add the correct login product, configure the exact HTTPS redirect URL, then replace the placeholders in META_CONFIG.';
  return;
 }
 const params=new URLSearchParams({client_id:META_CONFIG.appId,redirect_uri:META_CONFIG.redirectUri,response_type:'code',scope:META_CONFIG.scopes.join(',')});
 window.location.href='https://www.facebook.com/dialog/oauth?'+params.toString();
}
function metaLoginCallback(code){
 // Never exchange the authorization code or store an app secret in this HTML.
 // Your server should exchange the code securely, validate state/redirect URI,
 // then create the Instagram Pro session.
 console.log('Meta authorization code received. Send it to your secure backend.',code);
}
</script>
</body>
</html>
